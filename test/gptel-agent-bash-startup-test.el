;;; gptel-agent-bash-startup-test.el --- Reentrant foreground launch -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'gptel-agent)

(defun gptel-agent-bash-startup-test--wait (predicate)
  "Service real process events for up to five seconds until PREDICATE."
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.005))
    (should (funcall predicate))))

(defmacro gptel-agent-bash-startup-test--session (&rest body)
  "Run BODY in SOURCE with isolated saved output and guaranteed cleanup."
  (declare (indent 0))
  `(let ((source (generate-new-buffer " *bash-startup-test*"))
         (directory (make-temp-file "bash-startup-" t))
         (original (symbol-function 'make-process))
         (previous-processes (process-list))
         (gptel-agent--saved-tool-results (make-hash-table :test #'equal))
         (gptel-agent--result-resources (make-hash-table :test #'equal))
         (gptel-agent--results-timer nil))
     (unwind-protect
         (cl-letf (((symbol-function 'gptel-agent--tool-results-directory)
                    (lambda () directory)))
           (with-current-buffer source ,@body))
       (when (buffer-live-p source) (kill-buffer source))
       ;; A failing regression must not leave its long-running shell behind.
       (dolist (process (process-list))
         (unless (memq process previous-processes)
           (set-process-filter process #'ignore)
           (set-process-sentinel process #'ignore)
           (when (process-live-p process) (kill-process process))
           (delete-process process)))
       (when gptel-agent--results-timer (cancel-timer gptel-agent--results-timer))
       (delete-directory directory t))))

(defun gptel-agent-bash-startup-test--released (job process source fsm)
  "Assert JOB's execution resources are released, with no late resurrection."
  (should (gptel-agent--bash-done job))
  (should-not (process-live-p process))
  (should-not (process-get process 'gptel-agent-bash))
  (should-not (buffer-live-p (gptel-agent--bash-buffer job)))
  (should-not (gptel-agent--bash-timeout-timer job))
  (should-not (gptel-agent--bash-callback job))
  (should-not (gptel-agent--bash-fsm job))
  (should-not (plist-get (gptel-fsm-info fsm) :post))
  (when (buffer-live-p source)
    (should-not (buffer-local-value 'gptel-agent--bash-jobs source)))
  (gptel-agent--bash-filter job process "late output")
  (gptel-agent--bash-finish job process)
  (gptel-agent--bash-expire job)
  (when (buffer-live-p source)
    (should-not (buffer-local-value 'gptel-agent--bash-jobs source))))

(ert-deftest gptel-agent-bash-startup-completion-does-not-register-disposed-job ()
  (dolist (case '(("printf done" "done")
                  ("printf failed; exit 7"
                   "Command failed with exit code 7:\nSTDOUT+STDERR:\nfailed")))
    (gptel-agent-bash-startup-test--session
      (let ((fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
            results job process)
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq job (car gptel-agent--bash-jobs)
                           process (apply original args))
                     (gptel-agent-bash-startup-test--wait (lambda () results))
                     process)))
          (should (eq (gptel-agent--execute-bash
                       (lambda (result) (push result results))
                       (car case) "Read output" nil fsm)
                      process)))
        (gptel-agent-bash-startup-test--released job process source fsm)
        (should (equal results (list (cadr case))))))))

(ert-deftest gptel-agent-bash-startup-completion-preserves-capped-owned-result ()
  (gptel-agent-bash-startup-test--session
    (let ((gptel-agent-tool-result-max-chars 3)
          (gptel-agent-result-file-limit 7)
          (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
          results job process)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq job (car gptel-agent--bash-jobs)
                         process (apply original args))
                   (gptel-agent-bash-startup-test--wait (lambda () results))
                   process)))
        (gptel-agent--execute-bash (lambda (result) (push result results))
                                 "printf 'é猫ABCD'" "Read output" nil fsm))
      (gptel-agent-bash-startup-test--released job process source fsm)
      (should (= (length results) 1))
      (should (string-match-p "Partial result:" (car results)))
      (let* ((file (gptel-agent--bash-file job))
             (entry (gptel-agent--result-resource file)))
        (should (eq (plist-get entry :owner) source))
        (should (= (plist-get entry :bytes) 7))
        (should-not (plist-get entry :active))
        (should (file-exists-p file))
        (kill-buffer source)
        (should-not (file-exists-p file))
        (should (zerop (hash-table-count gptel-agent--result-resources)))
        (should-not gptel-agent--results-timer)))))

(ert-deftest gptel-agent-bash-startup-capture-failure-stops-live-process ()
  (dolist (failure '(write quota))
    (gptel-agent-bash-startup-test--session
      (let ((gptel-agent-tool-result-max-chars 3)
            (gptel-agent-result-count-limit (if (eq failure 'quota) 0 128))
            (append-output (symbol-function 'gptel-agent--result-append))
            (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
            results job process)
        (cl-letf (((symbol-function 'gptel-agent--result-append)
                   (lambda (&rest args)
                     (apply append-output args)
                     (when (eq failure 'write) (error "Simulated capture failure"))))
                  ((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq job (car gptel-agent--bash-jobs)
                           process (apply original args))
                     (gptel-agent-bash-startup-test--wait (lambda () results))
                     ;; The live group must be stopped before launch returns.
                     (should-not (process-live-p process))
                     process)))
          (gptel-agent--execute-bash (lambda (result) (push result results))
                                   "printf evidence; sleep 60" "Read output" nil fsm))
        (gptel-agent-bash-startup-test--released job process source fsm)
        (should (= (length results) 1))
        (should (string-match-p (if (eq failure 'write) "Simulated capture failure"
                                 "quota is full") (car results)))
        (should (string-match-p "Retained preview:\nevidence" (car results)))
        (should (zerop (hash-table-count gptel-agent--result-resources)))
        (should-not gptel-agent--results-timer)
        (should-not (directory-files directory nil directory-files-no-dot-files-regexp))))))

(ert-deftest gptel-agent-bash-startup-cancellation-releases-early-and-late-handles ()
  (dolist (cancel '(request owner abort))
    (dolist (output '(nil t detached))
      (gptel-agent-bash-startup-test--session
        (let ((gptel-agent-tool-result-max-chars 3)
              (gptel--request-alist nil)
              (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
              results job process)
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest args)
                       (setq job (car gptel-agent--bash-jobs)
                             ;; Some file handlers return a process with a
                             ;; separate buffer; only its returned handle can
                             ;; be acquired when no events have arrived yet.
                             process (apply original
                                            (if (eq output 'detached)
                                                (plist-put args :buffer nil)
                                              args)))
                       (when (eq output t)
                         (gptel-agent-bash-startup-test--wait
                          (lambda () (gptel-agent--bash-file job))))
                       (pcase cancel
                         ('request
                          (setf (gptel-fsm-state fsm) 'ABRT)
                          (gptel--handle-post fsm))
                         ('owner (kill-buffer source))
                         ('abort (gptel-abort source)))
                       (when (eq output 'detached)
                         (should (process-live-p process)))
                       process)))
            (gptel-agent--execute-bash (lambda (result) (push result results))
                                     "printf evidence; sleep 60" "Read output" nil fsm))
          (gptel-agent-bash-startup-test--released job process source fsm)
          (should-not results)
          (should (zerop (hash-table-count gptel-agent--result-resources)))
          (should-not gptel-agent--results-timer))))))

(ert-deftest gptel-agent-bash-startup-error-after-creation-recovers-buffer-process ()
  (dolist (failure '(error quit))
    (gptel-agent-bash-startup-test--session
      (let ((fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
            results job process)
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq job (car gptel-agent--bash-jobs)
                           process (apply original args))
                     ;; No filter or sentinel has supplied the handle yet.
                     (should-not (gptel-agent--bash-process job))
                     (signal failure '("Launch failed after process creation")))))
          (if (eq failure 'quit)
              (should (eq (condition-case nil
                              (gptel-agent--execute-bash #'ignore "sleep 60" "Read" nil fsm)
                            (quit 'cancelled)) 'cancelled))
            (gptel-agent--execute-bash (lambda (result) (push result results))
                                     "sleep 60" "Read output" nil fsm)))
        (gptel-agent-bash-startup-test--released job process source fsm)
        (if (eq failure 'quit) (should-not results)
          (should (equal results '("Error: Launch failed after process creation"))))))))

(ert-deftest gptel-agent-bash-startup-cancel-before-creation-suppresses-launch-error ()
  (dolist (cancel '(request owner abort))
    (gptel-agent-bash-startup-test--session
      (let ((gptel--request-alist nil)
            (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
            results job process)
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq job (car gptel-agent--bash-jobs))
                     (pcase cancel
                       ('request
                        (setf (gptel-fsm-state fsm) 'ABRT)
                        (gptel--handle-post fsm))
                       ('owner (kill-buffer source))
                       ('abort (gptel-abort source)))
                     ;; Native make-process accepts the released buffer as
                     ;; nil.  A late filter must stop this newly created handle.
                     (setq process (apply original args))
                     (gptel-agent-bash-startup-test--wait
                      (lambda () (not (process-live-p process))))
                     (error "Handler failed after cancellation"))))
          (should-not (gptel-agent--execute-bash
                       (lambda (result) (push result results))
                       "printf evidence; sleep 60" "Read output" nil fsm)))
        (should-not results)
        (gptel-agent-bash-startup-test--released job process source fsm)
        (should (zerop (hash-table-count gptel-agent--result-resources)))
        (should-not gptel-agent--results-timer)))))

(ert-deftest gptel-agent-bash-startup-error-after-result-never-calls-back-twice ()
  (gptel-agent-bash-startup-test--session
    (let ((fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
          results job process)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq job (car gptel-agent--bash-jobs)
                         process (apply original args))
                   (gptel-agent-bash-startup-test--wait (lambda () results))
                   (error "Handler failed after completion"))))
        (let ((err (should-error
                    (gptel-agent--execute-bash (lambda (result) (push result results))
                                             "printf done" "Read output" nil fsm))))
          (should (equal (error-message-string err) "Handler failed after completion"))))
      (gptel-agent-bash-startup-test--released job process source fsm)
      (should (equal results '("done"))))))

(ert-deftest gptel-agent-bash-startup-callback-can-launch-next-command ()
  (gptel-agent-bash-startup-test--session
    (let ((fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
          results job process replacement)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (if process (apply original args)
                     (setq job (car gptel-agent--bash-jobs)
                           process (apply original args))
                     (gptel-agent-bash-startup-test--wait (lambda () replacement))
                     process))))
        (gptel-agent--execute-bash
         (lambda (result)
           (push result results)
           (should-not gptel-agent--bash-jobs)
           (should-not (plist-get (gptel-fsm-info fsm) :post))
           (setq replacement (gptel-agent--execute-bash #'ignore "sleep 60" "Read" nil fsm)))
         "printf first" "Read output" nil fsm))
      (should (gptel-agent--bash-done job))
      (should-not (process-get process 'gptel-agent-bash))
      (should (equal gptel-agent--bash-jobs
                     (list (process-get replacement 'gptel-agent-bash))))
      (should (= (length (plist-get (gptel-fsm-info fsm) :post)) 1))
      (should (process-live-p replacement))
      (gptel-agent--bash-finish job process)
      (should (equal results '("first")))
      (setf (gptel-fsm-state fsm) 'ABRT)
      (gptel--handle-post fsm)
      (should-not (process-live-p replacement))
      (should-not gptel-agent--bash-jobs))))

(ert-deftest gptel-agent-bash-startup-cancellation-during-publish-stays-silent ()
  (dolist (cancel '(request owner))
    (gptel-agent-bash-startup-test--session
      (let ((gptel-agent-tool-result-max-chars 3)
            (publish (symbol-function 'gptel-agent--result-publish))
            (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
            results job process cancelled)
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq job (car gptel-agent--bash-jobs)
                           process (apply original args))
                     (gptel-agent-bash-startup-test--wait
                      (lambda () (gptel-agent--bash-done job)))
                     process))
                  ((symbol-function 'gptel-agent--result-publish)
                   (lambda (&rest args)
                     (prog1 (apply publish args)
                       ;; Publication can service a filename handler before
                       ;; finish has disposed the job and delivered its result.
                       (run-at-time
                        0 nil
                        (lambda ()
                          (setq cancelled t)
                          (if (eq cancel 'owner) (kill-buffer source)
                            (setf (gptel-fsm-state fsm) 'ABRT)
                            (gptel--handle-post fsm))))
                       (gptel-agent-bash-startup-test--wait (lambda () cancelled))))))
          (gptel-agent--execute-bash
           (lambda (result) (push result results)) "printf evidence" "Read" nil fsm))
        (should cancelled)
        (should-not results)
        (gptel-agent-bash-startup-test--released job process source fsm)
        (should (zerop (hash-table-count gptel-agent--result-resources)))
        (should (zerop (hash-table-count gptel-agent--saved-tool-results)))
        (should-not gptel-agent--results-timer)))))

(ert-deftest gptel-agent-bash-startup-reentrant-finish-publishes-and-calls-once ()
  (gptel-agent-bash-startup-test--session
    (let ((gptel-agent-tool-result-max-chars 3)
          (publish (symbol-function 'gptel-agent--result-publish))
          (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
          (publications 0)
          results job process nested)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq job (car gptel-agent--bash-jobs)
                         process (apply original args))
                   (gptel-agent-bash-startup-test--wait (lambda () results))
                   process))
                ((symbol-function 'gptel-agent--result-publish)
                 (lambda (&rest args)
                   (cl-incf publications)
                   (prog1 (apply publish args)
                     (unless nested
                       ;; A handler can service another completion while the
                       ;; first sentinel is still formatting its saved result.
                       (run-at-time
                        0 nil
                        (lambda ()
                          (setq nested t)
                          (gptel-agent--bash-finish job process)))
                       (gptel-agent-bash-startup-test--wait (lambda () nested)))))))
        (gptel-agent--execute-bash
         (lambda (result) (push result results)) "printf evidence" "Read" nil fsm))
      (should nested)
      (should (= publications 1))
      (should (= (length results) 1))
      (gptel-agent-bash-startup-test--released job process source fsm)
      (should (= (hash-table-count gptel-agent--result-resources) 1))
      (should (= (hash-table-count gptel-agent--saved-tool-results) 1))
      (should (file-exists-p (gptel-agent--bash-file job)))
      (kill-buffer source)
      (should (zerop (hash-table-count gptel-agent--result-resources)))
      (should-not gptel-agent--results-timer))))

(ert-deftest gptel-agent-bash-startup-expiry-stops-early-process-and-keeps-partial-result ()
  (gptel-agent-bash-startup-test--session
    (let ((gptel-agent-tool-result-max-chars 3)
          (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
          results job process)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq job (car gptel-agent--bash-jobs)
                         process (apply original args))
                   (gptel-agent-bash-startup-test--wait
                    (lambda () (gptel-agent--bash-file job)))
                   (gptel-agent--bash-expire job)
                   (should-not (process-live-p process))
                   process)))
        (gptel-agent--execute-bash
         (lambda (result) (push result results))
         "printf evidence; sleep 60" "Read" nil fsm))
      (should (= (length results) 1))
      (should (string-match-p "Command timed out" (car results)))
      (should (string-match-p "evidence" (car results)))
      (gptel-agent-bash-startup-test--released job process source fsm)
      (should (= (hash-table-count gptel-agent--saved-tool-results) 1))
      (should-not (plist-get (gptel-agent--result-resource
                             (gptel-agent--bash-file job)) :active))
      (kill-buffer source)
      (should-not gptel-agent--results-timer))))

(ert-deftest gptel-agent-bash-startup-cancellation-after-disposal-stays-silent ()
  (dolist (cancel '(request owner))
    (gptel-agent-bash-startup-test--session
      (let ((dispose (symbol-function 'gptel-agent--bash-dispose))
            (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
            results job process cancelled)
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq job (car gptel-agent--bash-jobs)
                           process (apply original args))
                     (gptel-agent-bash-startup-test--wait (lambda () cancelled))
                     process))
                  ((symbol-function 'gptel-agent--bash-dispose)
                   (lambda (&rest args)
                     (prog1 (apply dispose args)
                       ;; Resource disposal can run external hooks after it
                       ;; has removed the job's ordinary cancellation hook.
                       (unless cancelled
                         (setq cancelled t)
                         (if (eq cancel 'owner) (kill-buffer source)
                           (setf (gptel-fsm-state fsm) 'ABRT)
                           (gptel--handle-post fsm)))))))
          (gptel-agent--execute-bash
           (lambda (result) (push result results)) "printf done" "Read" nil fsm))
        (should cancelled)
        (should-not results)
        (gptel-agent-bash-startup-test--released job process source fsm)
        (should (zerop (hash-table-count gptel-agent--result-resources)))
        (should-not gptel-agent--results-timer)))))

(ert-deftest gptel-agent-bash-startup-cleanup-error-remains-one-useful-result ()
  (gptel-agent-bash-startup-test--session
    (let ((dispose (symbol-function 'gptel-agent--bash-dispose))
          (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
          results job process failed)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq job (car gptel-agent--bash-jobs)
                         process (apply original args))
                   (gptel-agent-bash-startup-test--wait
                    (lambda () (> (gptel-agent--bash-chars job) 0)))
                   ;; Expiry invokes the same finish/disposal path directly,
                   ;; so Emacs's event handler cannot swallow its exception.
                   (gptel-agent--bash-expire job)
                   process))
                ((symbol-function 'gptel-agent--bash-dispose)
                 (lambda (&rest args)
                   (prog1 (apply dispose args)
                     (unless failed
                       (setq failed t)
                       (error "Cleanup failed after resource disposal"))))))
        (should-not
         (gptel-agent--execute-bash
          (lambda (result) (push result results))
          "printf evidence; sleep 60" "Read" nil fsm)))
      (should failed)
      (should-not (gptel-agent--bash-cancelled job))
      (should (equal results '("Error: Cleanup failed after resource disposal")))
      (gptel-agent-bash-startup-test--released job process source fsm)
      (should (zerop (hash-table-count gptel-agent--result-resources)))
      (should-not gptel-agent--results-timer))))

