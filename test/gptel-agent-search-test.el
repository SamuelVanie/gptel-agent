;;; gptel-agent-search-test.el --- Repository search regressions -*- lexical-binding: t; -*-

(require 'gptel-agent-edit-test)
(require 'gptel-agent-read-test)

(defun gptel-agent-repo-test--backend (matcher walker)
  "Select MATCHER and WALKER, retaining the actual batch Emacs executable."
  (let ((backend (copy-tree (gptel-agent--repo-select-backend))))
    (plist-put backend :name matcher)
    (plist-put backend :program (unless (eq matcher 'emacs) (executable-find (symbol-name matcher))))
    (plist-put backend :walker walker)
    backend))

(defun gptel-agent-repo-test--call (name backend &rest args)
  "Run NAME with BACKEND and ARGS, checking bounded state until completion."
  (let (results job)
    (cl-letf (((symbol-function 'gptel-agent--repo-select-backend) (lambda () backend)))
      (apply (if (equal name "Glob") #'gptel-agent--glob #'gptel-agent--grep)
             (lambda (value) (push value results)) args))
    (setq job (car gptel-agent--repository-searches))
    (gptel-agent-read-test--wait
     (lambda ()
       (when job
         (should (<= (string-bytes (gptel-agent--repo-pending job)) 65536))
         (should (<= (length (gptel-agent--repo-stderr job)) 2048))
         (should (<= (length (gptel-agent--repo-entries job)) gptel-agent-search-max-entries)))
       results))
    (should (= (length results) 1))
    (should-not gptel-agent--repository-searches)
    (when job
      (should-not (process-live-p (gptel-agent--repo-process job)))
      (should-not (memq (gptel-agent--repo-timeout job) timer-list))
      (gptel-agent--repo-finish job "complete"))
    (should (= (length results) 1))
    (car results)))

(ert-deftest gptel-agent-repo-glob-preserves-semantics-across-walkers ()
  (gptel-edit-test--with-files '(("a.EL" . "a") (".hidden" . "h")
                                 ("node_modules/pkg/file.el" . "dependency")
                                 ("build/out.el" . "build") (".git/config" . "excluded")
                                 ("odd\nname.el" . "newline"))
                               (make-symbolic-link "." "loop")
                               (make-symbolic-link "absent" "broken")
                               (make-symbolic-link "a.EL" "alias.el")
                               (set-file-times "a.EL" (seconds-to-time 1000000000))
                               (let (reference)
                                 (dolist (walker '(python emacs))
                                   (when (or (eq walker 'emacs) (executable-find "python3"))
                                     (let* ((backend (gptel-agent-repo-test--backend 'emacs walker))
                                            (result (gptel-agent-repo-test--call "Glob" backend "*" "." nil "all"))
                                            (body (car (split-string result (regexp-quote "[Glob")))))
                                       (should (string-match-p "Glob complete" result))
                                       (dolist (needle '("node_modules" "build" "hidden" "directory symlink" "broken symlink" "file symlink"))
                                         (should (string-match-p needle body)))
                                       (should-not (string-match-p "\\.git" body))
                                       (should-not (string-match-p "loop/" body))
                                       (should (string-match-p (regexp-quote (prin1-to-string (expand-file-name "odd\nname.el"))) body))
                                       (if reference (should (equal reference body)) (setq reference body))
                                       (let ((shallow (gptel-agent-repo-test--call "Glob" backend "*.el" "." 1)))
                                         (should (string-match-p "a.EL" shallow))
                                         (should-not (string-match-p "out.el\\|pkg/file.el" shallow)))))))))

(ert-deftest gptel-agent-repo-grep-native-dialects-context-and-unusual-paths ()
  (gptel-edit-test--with-files '(("odd\n:name.el" . "before\nWARN42\nafter\nlast\n")
                                 ("nested/.hidden.EL" . "ERROR42\n")
                                 ("excluded.txt" . "WARN42\n") (".git/file.el" . "WARN42\n"))
                               (dolist (matcher '(rg grep emacs))
                                 (when (or (eq matcher 'emacs) (executable-find (symbol-name matcher)))
                                   (let* ((backend (gptel-agent-repo-test--backend matcher 'emacs))
                                          (pattern (if (eq matcher 'emacs) "WARN\\|ERROR" "WARN|ERROR"))
                                          (result (gptel-agent-repo-test--call "Grep" backend pattern "." "*.el" 1)))
                                     (should (string-match-p "Grep complete" result))
                                     (should (string-match-p ":2:WARN42" result))
                                     (should (string-match-p ":1-before" result))
                                     (should (string-match-p ":3-after" result))
                                     (should (string-match-p "hidden.EL" result))
                                     (should-not (string-match-p "excluded.txt\\|\\.git" result))
                                     (should (string-match-p "results=2" result))
                                     (should (string-match-p "No matching entries" (gptel-agent-repo-test--call "Grep" backend "absent" ".")))
                                     (should (string-match-p "incomplete:" (gptel-agent-repo-test--call "Grep" backend "[" "." "*.absent"))))))))

(ert-deftest gptel-agent-repo-limits-are-global-and-never-claim-no-matches ()
  (gptel-edit-test--with-files '(("a" . "hit\nhit\n") ("b" . "hit\nhit\n")
                                 ("nested/c" . "hit\n"))
                               (dolist (walker '(python emacs))
                                 (when (or (eq walker 'emacs) (executable-find "python3"))
                                   (let ((backend (gptel-agent-repo-test--backend 'emacs walker)))
                                     (let ((result (gptel-agent-repo-test--call "Glob" backend "*" "." nil "all" 2)))
                                       (should (string-match-p "incomplete: result limit" result))
                                       (should (string-match-p "results=2" result)))
                                     (let ((result (gptel-agent-repo-test--call "Glob" backend "no-match" "." nil nil nil 1)))
                                       (should (string-match-p "incomplete: traversal entry limit" result))
                                       (should-not (string-match-p "No matching" result)))
                                     (let ((gptel-agent-search-traversal-max-bytes 1))
                                       (should (string-match-p "incomplete: traversal byte limit"
                                                               (gptel-agent-repo-test--call "Grep" backend "hit" "."))))
                                     (let ((gptel-agent-tool-result-max-chars 5))
                                       (dolist (name '("Glob" "Grep"))
                                         (let ((result (gptel-agent-repo-test--call name backend (if (equal name "Glob") "*" "hit") ".")))
                                           (should (string-match-p "incomplete: output limit" result))
                                           (should (< (length result) 400))))))))
                               (dolist (matcher '(rg grep emacs))
                                 (when (or (eq matcher 'emacs) (executable-find (symbol-name matcher)))
                                   (let ((result (gptel-agent-repo-test--call "Grep" (gptel-agent-repo-test--backend matcher 'emacs)
                                                                              "hit" "." nil 0 nil 3)))
                                     (should (string-match-p "incomplete: match limit" result))
                                     (should (string-match-p "results=3" result)))))))

(ert-deftest gptel-agent-repo-giant-lines-and-invalid-arguments ()
  (gptel-edit-test--with-files `(("huge" . ,(concat (make-string (* 1024 1024) ?x) "\nneedle\n")))
                               (dolist (matcher '(rg grep emacs))
                                 (when (or (eq matcher 'emacs) (executable-find (symbol-name matcher)))
                                   (let ((result (gptel-agent-repo-test--call "Grep" (gptel-agent-repo-test--backend matcher 'emacs) "x" "huge")))
                                     (should (string-match-p "incomplete:" result))
                                     (should (< (length result) 3000)))))
                               (should-error (gptel-agent--grep #'ignore "x" "." nil -1))
                               (should-error (gptel-agent--glob #'ignore "**" "."))
                               (should-error (gptel-agent--glob #'ignore "*" "." 0))
                               (should-error (gptel-agent--glob #'ignore "*" "." nil nil 0))
                               (should-error (gptel-agent--grep #'ignore "x\0y" "."))))

(ert-deftest gptel-agent-repo-timeout-abort-kill-and-post-cleanup ()
  (gptel-edit-test--with-files '(("one" . "text"))
                               (dolist (reason '(timeout abort kill post))
                                 (let* ((source (generate-new-buffer " *repo-owner*"))
                                        (fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source)))
                                        (gptel-agent-search-timeout 0.05) job results)
                                   (unwind-protect
                                       (with-current-buffer source
                                         (let ((default-directory (file-name-as-directory directory)))
                                           (cl-letf (((symbol-function 'gptel-agent--repo-grep-batch)
                                                      (lambda (owned)
                                                        (gptel-agent--repo-launch owned (list (executable-find "sleep") "10")))))
                                             (gptel-agent--grep (lambda (value) (push value results)) "x" "one" nil nil nil nil nil fsm))
                                           (setq job (car gptel-agent--repository-searches))
                                           (pcase reason
                                             ('abort (gptel-agent--abort-with-owned-runs #'ignore source))
                                             ('kill (kill-buffer source))
                                             ('post (funcall (gptel-agent--repo-cleanup job)))
                                             ('timeout (gptel-agent-read-test--wait (lambda () results))))
                                           (should (gptel-agent--repo-done job))
                                           (should-not (process-live-p (gptel-agent--repo-process job)))
                                           (should-not (process-live-p (gptel-agent--repo-stderr-process job)))
                                           (should-not (memq (gptel-agent--repo-timeout job) timer-list))
                                           (should-not (plist-get (gptel-fsm-info fsm) :post))
                                           (gptel-agent--repo-finish job "complete")
                                           (if (eq reason 'timeout)
                                               (progn (should (= (length results) 1)) (should (string-match-p "incomplete: timeout" (car results))))
                                             (should-not results))))
                                     (when (buffer-live-p source) (kill-buffer source)))))))

(ert-deftest gptel-agent-repo-launch-failure-cleans-owned-resources ()
  (gptel-edit-test--with-files '(("one" . "text"))
                               (let ((backend (gptel-agent-repo-test--backend 'rg 'emacs)))
                                 (plist-put backend :program "/missing/rg")
                                 (should (string-match-p "advertised backend is unavailable"
                                                         (gptel-agent-repo-test--call "Grep" backend "x" "one"))))))

(ert-deftest gptel-agent-repo-subprocess-errors-fragments-and-bounded-stderr ()
  (gptel-edit-test--with-files '(("one" . "text"))
                               (let ((make (symbol-function 'make-process))
                                     (backend (gptel-agent-repo-test--backend 'emacs 'emacs)))
                                 (dolist (command '("exit 2" "printf invalid" "printf '%100000s' x >&2; exit 2"))
                                   (cl-letf (((symbol-function 'make-process)
                                              (lambda (&rest args)
                                                (apply make (plist-put args :command (list "/bin/sh" "-c" command))))))
                                     (let ((result (gptel-agent-repo-test--call "Grep" backend "x" "one")))
                                       (should (string-match-p "incomplete:" result))
                                       (should-not (string-match-p "No matching" result))
                                       (should (< (length result) 2500)))))
                                 (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (error "launch failed"))))
                                   (should (string-match-p "incomplete: launch failed"
                                                           (gptel-agent-repo-test--call "Grep" backend "x" "one"))))
                                 ;; Fragment every character, including the newline inside a filename.
                                 (cl-letf (((symbol-function 'make-process)
                                            (lambda (&rest args)
                                              (apply make (plist-put args :command (list (executable-find "sleep") "10"))))))
                                   (let (results)
                                     (gptel-agent--grep (lambda (value) (push value results)) "x" "one")
                                     (let* ((job (car gptel-agent--repository-searches))
                                            (process (gptel-agent--repo-process job)))
                                       (mapc (lambda (char) (gptel-agent--repo-filter job process (char-to-string char)))
                                             "/tmp/a\nb\0")
                                       (gptel-agent--repo-filter job process "12:found\n")
                                       (gptel-agent--repo-finish job "complete")
                                       (should (= (length results) 1))
                                       (should (string-match-p ":12:found" (car results)))))))))

(ert-deftest gptel-agent-repo-traversal-and-fallback-reads-stay-outside-caller ()
  (gptel-edit-test--with-files '(("nested/one.el" . "before\nneedle\nafter\n"))
                               (dolist (walker '(python emacs))
                                 (when (or (eq walker 'emacs) (executable-find "python3"))
                                   (let ((backend (gptel-agent-repo-test--backend 'emacs walker)))
                                     (cl-letf (((symbol-function 'directory-files) (lambda (&rest _) (ert-fail "Traversal in caller")))
                                               ((symbol-function 'insert-file-contents-literally) (lambda (&rest _) (ert-fail "Read in caller"))))
                                       (should (string-match-p "Glob complete" (gptel-agent-repo-test--call "Glob" backend "*.el" ".")))
                                       (should (string-match-p ":2:needle" (gptel-agent-repo-test--call "Grep" backend "needle" ".")))))))))

(ert-deftest gptel-agent-repo-multiple-batches-and-real-async-dispatch ()
  (gptel-edit-test--with-files (cl-loop for i below 70 collect (cons (format "file-%02d" i) "needle\n"))
                               (let* ((gptel-tools (list (gptel-get-tool "Glob") (gptel-get-tool "Grep")))
                                      (gptel-confirm-tool-calls nil) (gptel-agent-use-project-instructions nil)
                                      (backend (gptel-make-openai "repo-dispatch" :key "unused" :models '(test)))
                                      (fsm (gptel-make-fsm :table gptel-send--transitions
                                                           :handlers '((TOOL gptel--handle-tool-use))
                                                           :info (list :buffer (current-buffer) :backend backend :callback #'ignore)))
                                      (calls (list (list :name "Glob" :args '(:pattern "file-*" :depth 1))
                                                   (list :name "Grep" :args '(:regex "needle" :path "." :max_results 100)))))
                                 (gptel-agent--localize-agent-tool fsm)
                                 (setf (plist-get (gptel-fsm-info fsm) :tools) gptel-tools
                                       (plist-get (gptel-fsm-info fsm) :tool-use) calls)
                                 (gptel--fsm-transition fsm 'TOOL)
                                 (should (eq (gptel-fsm-state fsm) 'TOOL))
                                 (should (= (length gptel-agent--repository-searches) 2))
                                 (gptel-agent-read-test--wait (lambda () (eq (gptel-fsm-state fsm) 'TRET)))
                                 (dolist (call calls)
                                   (should (string-match-p "complete;" (plist-get call :result)))
                                   (should (string-match-p "results=70" (plist-get call :result))))
                                 (should-not gptel-agent--repository-searches))))

(ert-deftest gptel-agent-repo-wire-contract-refreshes-only-between-requests ()
  (skip-unless (and (executable-find "rg") (executable-find "grep")))
  (dolist (provider (list (gptel-make-openai "repo-oai" :key "unused" :models '(test))
                          (gptel-make-openai-responses "repo-responses" :key "unused" :models '(test))
                          (gptel-make-anthropic "repo-anthropic" :key "unused" :models '(test))
                          (gptel-make-gemini "repo-gemini" :key "unused" :models '(test))))
    (gptel-edit-test--with-files '(("one" . "WARN42\n"))
                                 (let* ((source (current-buffer)) (selected (gptel-agent-repo-test--backend 'rg 'emacs))
                                        (gptel-tools (list (gptel-get-tool "Grep") (gptel-get-tool "Glob")))
                                        (base (car gptel-tools)) (description (gptel-tool-description base))
                                        (gptel-backend provider) (gptel-model 'test) (gptel-use-tools t)
                                        (gptel-use-curl t) (gptel-stream nil) (gptel-post-request-hook nil) request wire)
                                   (cl-letf (((symbol-function 'gptel-agent--repo-select-backend) (lambda () selected))
                                             ((symbol-function 'gptel-curl-get-response)
                                              (lambda (fsm) (setq request fsm wire (gptel--json-encode (plist-get (gptel-fsm-info fsm) :data))))))
                                     (gptel-request "Find warnings" :buffer source :callback #'ignore
                                                    :transforms '(gptel-agent--localize-agent-tool))
                                     (should (string-match-p "ripgrep/Rust" wire))
                                     (should (string-match-p "wildcard-to-regexp" wire))
                                     (let ((old (car (plist-get (gptel-fsm-info request) :tools))) results)
                                       (setq selected (gptel-agent-repo-test--backend 'grep 'emacs))
                                       (with-temp-buffer
                                         (setq-local gptel-tools (list old))
                                         (gptel-agent--localize-repository-search request)
                                         (should (string-match-p "ripgrep/Rust" (gptel-tool-description (car gptel-tools)))))
                                       (setf (gptel-fsm-state request) 'TOOL)
                                       (funcall (gptel-tool-function old) (lambda (value) (push value results)) "(?i:warn)[0-9]+" "one")
                                       (gptel-agent-read-test--wait (lambda () results))
                                       (should (string-match-p "backend=rg" (car results)))
                                       (should (string-match-p ":1:WARN42" (car results)))
                                       (gptel--handle-wait request)
                                       (should (string-match-p "grep -E" wire))
                                       (should-not (string-match-p "ripgrep/Rust" wire))
                                       (setq selected (gptel-agent-repo-test--backend 'emacs 'emacs))
                                       (gptel--handle-wait request)
                                       (should (string-match-p "Native Emacs regular expressions" wire))
                                       (should (equal description (gptel-tool-description base)))))))))

(provide 'gptel-agent-search-test)
