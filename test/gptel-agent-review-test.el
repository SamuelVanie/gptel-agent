(ert-deftest gptel-review-commit-write-failure-rolls-back-and-keeps-decisions ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "old\n"))
				 (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
				 (gptel-review-test--submit "Edit" '(:path "two" :old_str "old" :new_str "fail"))
				 (let ((write (symbol-function 'gptel-agent-edit--write)))
				   (cl-letf (((symbol-function 'gptel-agent-edit--write)
					      (lambda (change content)
						(if (equal content "fail\n") (error "Simulated failure")
						  (funcall write change content)))))
				     (gptel-review-test--in-queue
				      (gptel-agent-review-accept-all)
				      (should-error (gptel-agent-review-done)))))
				 (should-not outcomes)
				 (should gptel-agent-review--queue)
				 (should (equal (gptel-edit-test--read "one") "old\n"))
				 (should (equal (gptel-edit-test--read "two") "old\n"))
				 (gptel-review-test--in-queue (gptel-agent-review-done))
				 (should (equal (gptel-edit-test--read "one") "new\n"))
				 (should (equal (gptel-edit-test--read "two") "fail\n"))))

(ert-deftest gptel-review-owner-killed-discards-proposals-and-timer ()
  (gptel-review-test--with-files nil
				 (let ((owner (generate-new-buffer " *review-owner*")) queue-buffer timer)
				   (unwind-protect
				       (progn
					 (with-current-buffer owner
					   (gptel-review-test--submit "Write" '(:path "." :filename "new" :content "created"))
					   (setq queue-buffer (gptel-agent-review--queue-buffer gptel-agent-review--queue))
					   (setq gptel-agent-review--delivery-timer (run-at-time 100 nil #'ignore)
						 timer gptel-agent-review--delivery-timer))
					 (kill-buffer owner)
					 (should-not (buffer-live-p queue-buffer))
					 (should-not (memq timer timer-list))
					 (should-not (file-exists-p "new"))
					 (should-not outcomes))
				     (when (buffer-live-p owner) (kill-buffer owner))))))

(ert-deftest gptel-review-feedback-does-not-restart-aborted-request ()
  (with-temp-buffer
    (let ((fsm (gptel-make-fsm :state 'WAIT :info (list :buffer (current-buffer)))))
      (setq-local gptel--fsm-last fsm)
      (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'gptel-send) (lambda (&rest _) (ert-fail "Restarted cancelled request"))))
        (gptel-agent-review--deliver (current-buffer) "Please revise" t)
        (setf (gptel-fsm-state fsm) 'ABRT)
        (gptel-agent-review--flush (current-buffer))
        (should (string-match-p "Please revise" (buffer-string)))
        (should-not gptel-agent-review--delivery)))))

(ert-deftest gptel-review-staged-reads-do-not-bypass-result-explorer-scope ()
  (gptel-review-test--with-files '(("one" . "old\n"))
				 (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
				 (let ((gptel-agent--result-file-scope "/scoped/result"))
				   (should-not (gptel-agent-review-read '(:file_path "one"))))))

