(ert-deftest gptel-agent-search-snapshot-change-and-timeout-are-incomplete ()
  (gptel-agent-read-test--with-file (file source "needle\n")
                                    (let (results job)
                                      (cl-letf (((symbol-function 'executable-find) (lambda (&rest _) nil)))
                                        (gptel-agent--grep-scoped-result (lambda (value) (push value results)) "needle"))
                                      (setq job (car gptel-agent--searches))
                                      (write-region "changed" nil file nil 'silent)
