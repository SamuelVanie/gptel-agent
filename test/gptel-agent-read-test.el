;;; gptel-agent-read-test.el --- Bounded read/search regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'gptel-agent)
(require 'gptel-openai)
(require 'gptel-openai-responses)
(require 'gptel-anthropic)
(require 'gptel-gemini)
(require 'gptel-agent-review)

(defun gptel-agent-read-test--wait (predicate)
  (let ((deadline (+ (float-time) 15)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(cl-defmacro gptel-agent-read-test--with-file ((file source text) &body body)
  (declare (indent 1))
  `(let ((,file (make-temp-file "gptel-read-"))
         (,source (generate-new-buffer " *gptel-read-test*"))
         (gptel-agent--saved-tool-results (make-hash-table :test #'equal)))
     (unwind-protect
         (progn
           (let ((coding-system-for-write 'utf-8-unix)) (write-region ,text nil ,file nil 'silent))
           (puthash ,file '(:query "Find evidence") gptel-agent--saved-tool-results)
           (with-current-buffer ,source
             (setq-local gptel-agent--current-agent "result-explorer"
                         gptel-agent--result-file-scope ,file)
             ,@body))
       (when (buffer-live-p ,source) (kill-buffer ,source))
       (delete-file ,file))))

(defun gptel-agent-read-test--search (backend regex &optional sensitive max-results offset)
  "Run one search, forcing BACKEND, and verify retained state while it runs."
  (let ((find (symbol-function 'executable-find)) results job)
    (cl-letf (((symbol-function 'executable-find)
               (lambda (program &rest args)
                 (when (equal program backend) (apply find program args)))))
      (should-not (gptel-agent--grep-scoped-result
                   (lambda (result) (push result results)) regex sensitive max-results offset))
      (setq job (car gptel-agent--searches))
      (should (or job results))
      (when job
        (gptel-agent-read-test--wait
         (lambda ()
           (should (<= (length (gptel-agent--search-carry job)) 65536))
           (should (<= (length (gptel-agent--search-pending job)) 8192))
           (should (<= (length (gptel-agent--search-stderr job)) 2048))
           (should (<= (length (gptel-agent--search-candidates job)) (or max-results 50)))
           (should (<= (gptel-agent--search-used job) gptel-agent-tool-result-preview-chars))
           results))))
    (should (= (length results) 1))
    (when job
      (should (gptel-agent--search-done job))
      (should-not gptel-agent--searches)
      (should-not (and (gptel-agent--search-process job)
                       (process-live-p (gptel-agent--search-process job))))
      (gptel-agent--search-finish job "complete"))
    (should (= (length results) 1))
    (car results)))

(defmacro gptel-agent-read-test--backends (&rest body)
  (declare (indent 0))
  `(dolist (backend '("rg" "grep" nil))
     (when (or (null backend) (executable-find backend))
       ,@body)))

(ert-deftest gptel-agent-read-bounds-huge-line-before-allocation ()
  (gptel-agent-read-test--with-file (file source (concat (make-string (* 4 1024 1024) ?x) "\nlast\n"))
                                    (let ((read (symbol-function 'insert-file-contents-literally)) (high 0) (total 0)
                                          (gptel-agent-read-file-size-threshold 4))
                                      (cl-letf (((symbol-function 'insert-file-contents-literally)
                                                 (lambda (name visit begin end &rest args)
                                                   (should (and begin end (<= (- end begin) 65536)))
                                                   (setq high (max high (- end begin)) total (+ total (- end begin)))
                                                   (apply read name visit begin end args))))
                                        (let ((result (gptel-agent--read-file-lines file 1 1)))
                                          (should (string-match-p "start_line=1, start_column=4097" result))
                                          (should (< (length result) 4400))
                                          (should (<= total 65536)))
                                        (should (equal (gptel-agent--read-file-lines file 2 2) "last\n"))
                                        (should (= high 65536))
                                        (should-error (gptel-agent--read-file-lines file nil nil))
                                        (should (string-match-p "start_column=8193"
                                                                (gptel-agent--read-file-lines file 1 nil 4097)))))))

(ert-deftest gptel-agent-read-unicode-boundaries-and-continuation ()
  (let ((gptel-agent--read-chunk-size 7))
    (gptel-agent-read-test--with-file (file source "a🙂éz\n二行\nlast")
                                      (should (equal (gptel-agent--read-file-lines file 1 2) "a🙂éz\n二行\n"))
                                      (should (equal (gptel-agent--read-file-lines file 2 nil) "二行\nlast"))
                                      (should (equal (gptel-agent--read-file-lines file 1 1 6) "éz\n"))
                                      (should-error (gptel-agent--read-file-lines file 1 1 3))
                                      (should-error (gptel-agent--read-file-lines file 1 1 100))
                                      (let ((page (gptel-agent--read-range file 1 nil nil 6)))
                                        (should (equal (plist-get page :text) "a🙂"))
                                        (should (= (plist-get page :column) 6))
                                        (should (plist-get page :limited)))
                                      (should (equal (gptel-agent--read-file-lines file 9 10) "")))))

(ert-deftest gptel-agent-read-pages-reconstruct-utf8-without-gaps ()
  (let ((text "α🙂one\n\n二éline\nend🙂"))
    (gptel-agent-read-test--with-file (file source text)
                                      (dolist (gptel-agent--read-chunk-size '(7 16 65536))
                                        (dolist (limit '(4 5 7 9 16))
                                          (let ((line 1) (column 1) pieces page)
                                            (while (progn
                                                     (setq page (gptel-agent--read-range file line nil column limit))
                     (let ((staged (gptel-agent--read-string-range text line nil column limit)))
                       (dolist (key '(:text :limited :line :column))
                         (should (equal (plist-get page key) (plist-get staged key)))))
                                                     (should (<= (string-bytes (plist-get page :text)) limit))
                                                     (push (plist-get page :text) pieces)
                                                     (setq line (plist-get page :line) column (plist-get page :column))
                                                     (plist-get page :limited)))
                                            (should (equal (apply #'concat (nreverse pieces)) text))))))))

(ert-deftest gptel-agent-read-staged-range-enforces-limit-through-review ()
  (gptel-agent-read-test--with-file (file source "disk content")
                                    (setq-local gptel-agent--result-file-scope nil)
                                    (let* ((gptel-agent-read-file-size-threshold 1)
                                           (text (concat (make-string (* 4 1024 1024) ?x) "\nlast\n"))
                                           (gptel-agent-review--queue
                                            (gptel-agent-review--make-queue
                                             :owner source :applied nil :files (list (list :path file :after text)))))
                                      (let ((result (plist-get (gptel-agent-review-read (list :file_path file :start_line 1 :end_line 1)) :result)))
                                        (should (< (length result) 1300))
                                        (should (string-match-p "start_line=1, start_column=1025" result)))
                                      (should (equal (plist-get (gptel-agent-review-read (list :file_path file :start_line 2 :end_line 2)) :result)
                                                     "last\n")))))

(ert-deftest gptel-agent-read-scoped-limits-and-staged-read ()
  (gptel-agent-read-test--with-file (file source (concat (make-string 1000000 ?a) "\nnext\n"))
                                    (let ((gptel-agent-tool-result-preview-chars 1000))
                                      (let ((result (gptel-agent--read-scoped-result 1 2)))
                                        (should (< (length result) 1200))
                                        (should (string-match-p "ResultRead incomplete" result)))
                                      (should (string-match-p ":2:next" (gptel-agent--read-scoped-result 2 2)))
                                      (should-error (gptel-agent--read-scoped-result 1 201)))
                                    (let ((page (gptel-agent--read-string-range (concat (make-string 1000000 ?a) "\nnext\n") 1 nil 1 4096)))
                                      (should (= (length (plist-get page :text)) 4096))
                                      (should (= (plist-get page :column) 4097))
                                      (should (plist-get page :limited)))
                                    (should (equal (plist-get (gptel-agent--read-string-range "one\né🙂\nlast" 2 2 3 100) :text) "🙂\n"))))

(ert-deftest gptel-agent-search-native-backends-unicode-alternatives-and-columns ()
  (gptel-agent-read-test--with-file (file source "startup\n\tÉé🙂ERROR ERRORLONG x.y [a]\nerror WARN\n")
                                    (gptel-agent-read-test--backends
                                     (let ((result (gptel-agent-read-test--search backend (if backend "ERRORLONG|ERROR" "ERRORLONG\\|ERROR") t)))
                                       (should (string-match-p ":2:10:" result))
                                       (should (string-match-p ":2:16:" result))
                                       (should (string-match-p "ResultGrep complete" result))
                                       (should-not (string-match-p ":3:" result)))
                                     (should (string-match-p ":3:1:" (gptel-agent-read-test--search backend "error")))
                                     (should (string-match-p ":2:4:" (gptel-agent-read-test--search backend "é" t)))
                                     (should (string-match-p ":2:26:" (gptel-agent-read-test--search backend "x\\.y")))
                                     (should (string-match-p "No nonempty matches" (gptel-agent-read-test--search backend "absent"))))))

(ert-deftest gptel-agent-search-large-lines-and-chunk-overlap-are-bounded ()
  (gptel-agent-read-test--with-file
   (file source (concat (make-string 65526 ?x) "🙂needle\n" (make-string (* 4 1024 1024) ?z) "needle\nlast needle\n"))
   (let ((read (symbol-function 'insert-file-contents-literally)) (largest 0))
     (cl-letf (((symbol-function 'insert-file-contents-literally)
                (lambda (name visit begin end &rest args)
                  (should (and begin end (<= (- end begin) 65536)))
                  (prog1 (apply read name visit begin end args)
                    (setq largest (max largest (buffer-size)))))))
       (gptel-agent-read-test--backends
        (let ((result (gptel-agent-read-test--search backend (if backend "🙂needle|needle" "🙂needle\\|needle") t)))
          (should (string-match-p ":1:65527:" result))
          (should (string-match-p ":3:6:" result))
          (if backend
              (progn
                (should (string-match-p ":2:4194305:" result))
                (should (string-match-p "ResultGrep complete" result)))
            (should (string-match-p "incomplete: skipped 1 lines" result))
            (should (string-match-p "first skipped line=2" result)))))
       (should (<= largest 65536))))))

(ert-deftest gptel-agent-search-limits-and-continuation-agree ()
  (gptel-agent-read-test--with-file (file source "aaaaa\naa\n")
                                    (gptel-agent-read-test--backends
                                     (let ((result (gptel-agent-read-test--search backend (if backend "aa|a" "aa\\|a") t 2)))
                                       (should (string-match-p ":1:1:" result))
                                       (should (string-match-p ":1:3:" result))
                                       (should (string-match-p "incomplete: match limit" result))
                                       (should (string-match-p "next_start_byte=4" result)))
                                     (let ((result (gptel-agent-read-test--search backend (if backend "aa|a" "aa\\|a") t 10 4)))
                                       (should (string-match-p ":1:5:" result))
                                       (should (string-match-p ":2:1:" result))
                                       (should (string-match-p "complete;" result)))
                                     (let* ((gptel-agent-tool-result-preview-chars 0)
                                            (result (gptel-agent-read-test--search backend "a" t)))
                                       (should (string-match-p "incomplete: output limit" result))
                                       (should-not (string-match-p "No nonempty matches" result))
                                       (should (string-match-p "next_start_byte=0" result))))))

(ert-deftest gptel-agent-search-empty-file-and-rejected-regex-and-scope ()
  (gptel-agent-read-test--with-file (file source "")
                                    (gptel-agent-read-test--backends
                                     (should (string-match-p "No nonempty matches" (gptel-agent-read-test--search backend "x"))))
                                    (dolist (pattern '("" "x\ny"))
                                      (should-error (gptel-agent--grep-scoped-result #'ignore pattern)))
                                    (should-error (gptel-agent--grep-scoped-result #'ignore (make-string 4097 ?x)))
                                    (remhash file gptel-agent--saved-tool-results)
                                    (should-error (gptel-agent--grep-scoped-result #'ignore "x"))
                                    (should-error (gptel-agent--read-scoped-result 1 1))))

(ert-deftest gptel-agent-search-cancellation-does-not-revive-a-request ()
  (gptel-agent-read-test--with-file (file source (make-string 100000 ?x))
                                    (let ((fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source))) results job)
                                      (cl-letf (((symbol-function 'executable-find) (lambda (&rest _) nil)))
                                        (gptel-agent--grep-scoped-result (lambda (value) (push value results)) "x" t 2 nil fsm))
                                      (setq job (car gptel-agent--searches))
                                      (should (plist-get (gptel-fsm-info fsm) :post))
                                      (funcall (gptel-agent--search-cleanup job))
                                      (gptel-agent--search-filter job nil "1:0:x\n")
                                      (gptel-agent--search-finish job "complete")
                                      (accept-process-output nil 0.02)
                                      (should-not results)
                                      (should-not (plist-get (gptel-fsm-info fsm) :post))
                                      (should-not gptel-agent--searches))))

(ert-deftest gptel-agent-search-source-kill-and-obsolete-fsm-stop-external-process ()
  (dolist (kind '(kill obsolete abort))
    (gptel-agent-read-test--with-file (file source "needle\n")
                                      (let ((fsm (gptel-make-fsm :state 'TOOL :info (list :buffer source))) results
                                            (make (symbol-function 'make-process)) job)
                                        (cl-letf (((symbol-function 'make-process)
                                                   (lambda (&rest args)
                                                     (setq args (plist-put args :command '("/bin/sleep" "5")))
                                                     (apply make args))))
                                          (gptel-agent--grep-scoped-result (lambda (value) (push value results)) "needle" t 10 nil fsm))
                                        (setq job (car gptel-agent--searches))
                                        (pcase kind
                                          ('kill (kill-buffer source))
                                          ('abort (gptel-agent--abort-with-owned-runs #'ignore source))
                                          ('obsolete (setf (gptel-fsm-state fsm) 'DONE)
                                                     (gptel-agent--search-filter job nil "1:0:needle\n")))
                                        (should (gptel-agent--search-done job))
                                        (should-not (process-live-p (gptel-agent--search-process job)))
                                        (should-not results)))))

