(ert-deftest gptel-agent-search-wire-schema-and-backend-refresh-all-providers ()
  (skip-unless (and (executable-find "rg") (executable-find "grep")))
  (dolist (provider (list (gptel-make-openai "read-oai" :key "unused" :models '(test))
                          (gptel-make-openai-responses "read-responses" :key "unused" :models '(test))
                          (gptel-make-anthropic "read-anthropic" :key "unused" :models '(test))
                          (gptel-make-gemini "read-gemini" :key "unused" :models '(test))))
    (gptel-agent-read-test--with-file (file source "WARN42\n")
                                      (let* ((find (symbol-function 'executable-find))
                                             (selected "rg")
                                             (gptel-prompt-transform-functions '(gptel-agent--localize-agent-tool))
                                             (gptel-post-request-hook nil)
                                             (gptel-tools (list (gptel-get-tool "ResultGrep")))
                                             (base (car gptel-tools))
                                             (base-description (gptel-tool-description base))
                                             (gptel-backend provider) (gptel-model 'test)
                                             (gptel-use-curl t) (gptel-stream nil) (gptel-use-tools t)
                                             request wire)
                                        (cl-letf (((symbol-function 'executable-find)
                                                   (lambda (program &rest args)
                                                     (when (equal program selected) (apply find program args))))
                                                  ((symbol-function 'gptel-curl-get-response)
                                                   (lambda (fsm)
                                                     (setq request fsm wire (gptel--json-encode (plist-get (gptel-fsm-info fsm) :data))))))
                                          ;; Inspect actual serialized payload before any model/tool response.
                                          (gptel-request "Find warnings" :buffer source :callback #'ignore
                                                         :transforms gptel-prompt-transform-functions)
                                          (should request)
                                          (should (string-match-p "Selected backend: rg (ripgrep)" wire))
                                          (should (string-match-p "ripgrep/Rust regex syntax" wire))
                                          (let* ((info (gptel-fsm-info request))
                                                 (old-tool (car (plist-get info :tools)))
                                                 (captured (plist-get info :agent-result-search-backend)) results)
                                            (should (eq (plist-get captured :name) 'rg))
                                            (should-not (eq old-tool base))
                                            (should (string-match-p "ripgrep/Rust" (plist-get (car (gptel-tool-args old-tool)) :description)))
            ;; A newly preferred backend does not change an advertised query.
            (setq selected "grep")
            (with-temp-buffer
              (setq-local gptel-tools (list old-tool))
              (gptel-agent--localize-result-search request)
              (should (string-match-p "ripgrep/Rust" (gptel-tool-description (car gptel-tools)))))
            (setf (gptel-fsm-state request) 'TOOL)
                                            (funcall (gptel-tool-function old-tool) (lambda (value) (push value results)) "(?i:warn)[0-9]+" t)
                                            (gptel-agent-read-test--wait (lambda () results))
                                            (should (string-match-p "backend=rg" (car results)))
                                            (should (string-match-p ":1:1:" (car results)))
                                            ;; Missing executable fails under the old contract, without fallback.
                                            (setq results nil)
                                            (let ((executable (symbol-function 'file-executable-p)))
                                              (cl-letf (((symbol-function 'file-executable-p)
                                                         (lambda (path) (and (not (equal path (plist-get captured :program)))
                                                                             (funcall executable path)))))
                                                (funcall (gptel-tool-function old-tool) (lambda (value) (push value results)) "(?i:warn)")))
                                            (should (= (length results) 1))
                                            (should (string-match-p "advertised rg backend is unavailable" (car results)))
                                            (should-not gptel-agent--searches)
                                            ;; Refresh both dispatch and wire schema before the next model call.
                                            (gptel--handle-wait request)
                                            (should (string-match-p "Selected backend: grep -E" wire))
                                            (should-not (string-match-p "ripgrep/Rust" wire))
                                            (should (eq (plist-get (plist-get (gptel-fsm-info request) :agent-result-search-backend) :name) 'grep))
                                            (setq selected nil)
                                            (gptel--handle-wait request)
                                            (should (string-match-p "Selected backend: bounded Emacs fallback" wire))
                                            (should (string-match-p "native Emacs regular expressions" wire))
                                            (should (string-match-p "Lines exceeding 65536 bytes" wire)))
                                          (should (equal (gptel-tool-description base) base-description)))))))

