;;; gptel-agent-session-checkpoint-test.el --- Atomic family checkpoints -*- lexical-binding: t; -*-

(require 'ert)
(require 'gptel-agent-session-manager-test)

(defun gptel-agent-session-checkpoint-test--text (buffer)
  "Return BUFFER's committed transcript."
  (plist-get (gptel-agent-session--read
              (gptel-agent-session-manager-test--id buffer)) :text))

(defun gptel-agent-session-checkpoint-test--append (buffer text)
  "Append TEXT to BUFFER as an ordinary edit."
  (with-current-buffer buffer (goto-char (point-max)) (insert text)))

(ert-deftest gptel-agent-session-checkpoint-initial-family-is-hidden-until-complete ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *initial-family*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *initial-child*"))
           (grandchild (gptel-agent-session-manager-test--child child " *initial-grandchild*")))
      (gptel-agent-session-mode 1)
      (dotimes (_ 2)
        (should (= 1 (gptel-agent-session--drain)))
        (should-not (gptel-agent-session--catalog)))
      (should (= 1 (gptel-agent-session--drain)))
      (should (= 3 (length (gptel-agent-session--catalog))))
      (dolist (buffer (list parent child grandchild))
        (should (stringp (gptel-agent-session-checkpoint-test--text buffer)))))))

(ert-deftest gptel-agent-session-checkpoint-partial-batch-keeps-previous-family ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *checkpoint-parent*" "Parent old"))
           (child (gptel-agent-session-manager-test--child parent " *checkpoint-child*"))
           old-child)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq old-child (gptel-agent-session-checkpoint-test--text child))
      (gptel-agent-session-checkpoint-test--append parent " new")
      (gptel-agent-session-checkpoint-test--append child " new")
      (should (= 1 (gptel-agent-session--drain)))
      ;; Reading here models a restart's committed view without the explicit
      ;; flush that normal mode-disable or shutdown intentionally performs.
      (should (equal "Parent old" (gptel-agent-session-checkpoint-test--text parent)))
      (should (equal old-child (gptel-agent-session-checkpoint-test--text child)))
      (should (= 1 (gptel-agent-session--drain)))
      (should (equal "Parent old new" (gptel-agent-session-checkpoint-test--text parent)))
      (should (equal (concat old-child " new") (gptel-agent-session-checkpoint-test--text child))))))

(ert-deftest gptel-agent-session-checkpoint-manifest-failure-preserves-previous-family ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *manifest-parent*" "Old"))
           (child (gptel-agent-session-manager-test--child parent " *manifest-child*"))
           (rename (symbol-function 'rename-file)) old-child)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq old-child (gptel-agent-session-checkpoint-test--text child))
      (gptel-agent-session-checkpoint-test--append parent " updated")
      (gptel-agent-session-checkpoint-test--append child " updated")
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (old new &optional replace)
                   (when (string-prefix-p (file-truename (expand-file-name "families/" gptel-agent-session-directory))
                                          (file-truename new))
                     (signal 'file-error '("Simulated family publication failure")))
                   (funcall rename old new replace))))
        (gptel-agent-session--drain t))
      (should (equal "Old" (gptel-agent-session-checkpoint-test--text parent)))
      (should (equal old-child (gptel-agent-session-checkpoint-test--text child)))
      (gptel-agent-session--drain t)
      (should (equal "Old updated" (gptel-agent-session-checkpoint-test--text parent)))
      (should (equal (concat old-child " updated") (gptel-agent-session-checkpoint-test--text child))))))

(ert-deftest gptel-agent-session-checkpoint-restart-restores-previous-complete-family ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *restart-family*" "Committed parent"))
           (child (gptel-agent-session-manager-test--child parent " *restart-child*"))
           root-id child-text)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq root-id (gptel-agent-session-manager-test--id parent)
            child-text (gptel-agent-session-checkpoint-test--text child))
      (gptel-agent-session-checkpoint-test--append parent " UNCOMMITTED")
      (gptel-agent-session-checkpoint-test--append child " UNCOMMITTED")
      (gptel-agent-session--drain)
      ;; Drop only volatile state, bypassing graceful shutdown/kill snapshots.
      (let ((gptel-agent-session--restoring t))
        (dolist (buffer (list child parent))
          (with-current-buffer buffer
            (let ((kill-buffer-query-functions nil) (kill-buffer-hook nil))
              (set-buffer-modified-p nil)
              (kill-buffer buffer)))))
      (mapc #'clrhash (list gptel-agent-session--buffers gptel-agent-session--dirty
                            gptel-agent-session--transactions gptel-agent-session--family-members
                            gptel-agent-session--member-roots))
      (setq gptel-agent-session--queue nil gptel-agent-session--queue-tail nil)
      (setq gptel-agent-session--checkpoint-initialized nil)
      (gptel-agent-session--stop-if-clean)
      (gptel-agent-session-store--forget gptel-agent-session-directory)
      (setq parent (gptel-agent-session-restore root-id))
      (should (equal "Committed parent" (with-current-buffer parent (buffer-string))))
      (let ((children (buffer-local-value 'gptel-agent-discussion--children parent)))
        (should (= 1 (length children)))
        (setq child (gptel-agent-discussion--chat-buffer (car children)))
        (should (buffer-live-p child))
        (should (equal child-text (with-current-buffer child (buffer-string))))
        (should (eq parent (gptel-agent-discussion--chat-owner (car children))))))))

(ert-deftest gptel-agent-session-checkpoint-later-edits-wait-for-next-generation ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *revised-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *revised-child*"))
           (write (symbol-function 'gptel-agent-session--write)) written)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-checkpoint-test--append parent " generation-one")
      (gptel-agent-session-checkpoint-test--append child " generation-one")
      (cl-letf (((symbol-function 'gptel-agent-session--write)
                 (lambda (record)
                   (push (plist-get record :id) written)
                   (funcall write record))))
        (should (= 1 (gptel-agent-session--drain)))
        (let ((staged (cl-find (car written) (list parent child)
                               :key #'gptel-agent-session-manager-test--id :test #'equal)))
          (should staged)
          (gptel-agent-session-checkpoint-test--append staged " generation-two")
          (should (= 1 (gptel-agent-session--drain)))
          (should (string-suffix-p " generation-one"
                                   (gptel-agent-session-checkpoint-test--text staged)))
          (should (gethash staged gptel-agent-session--dirty))
          (gptel-agent-session--drain t)
          (should (string-suffix-p " generation-one generation-two"
                                   (gptel-agent-session-checkpoint-test--text staged)))
          (should (= 3 (length written))))))))

(ert-deftest gptel-agent-session-checkpoint-new-child-joins-before-publication ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *growing-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *growing-child*"))
           newer)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-checkpoint-test--append parent " updated")
      (gptel-agent-session-checkpoint-test--append child " updated")
      (gptel-agent-session--drain)
      (setq newer (gptel-agent-session-manager-test--child parent " *new-during-checkpoint*"))
      (gptel-agent-session--drain)
      (should (= 2 (length (gptel-agent-session--catalog))))
      (should (equal "Parent" (gptel-agent-session-checkpoint-test--text parent)))
      (gptel-agent-session--drain)
      (should (= 3 (length (gptel-agent-session--catalog))))
      (should (stringp (gptel-agent-session-checkpoint-test--text newer)))
      (should (equal "Parent updated" (gptel-agent-session-checkpoint-test--text parent))))))

(ert-deftest gptel-agent-session-checkpoint-killed-child-remains-in-family ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *killed-member-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *killed-member-child*"))
           child-id child-text)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq child-id (gptel-agent-session-manager-test--id child))
      (gptel-agent-session-checkpoint-test--append parent " updated")
      (gptel-agent-session-checkpoint-test--append child " final unsaved edit")
      (setq child-text (with-current-buffer child (buffer-string)))
      (gptel-agent-session--drain)
      (kill-buffer child)
      (gptel-agent-session-save)
      (should (= 2 (length (gptel-agent-session--catalog))))
      (should (equal child-text (plist-get (gptel-agent-session--read child-id) :text)))
      (should (equal (gptel-agent-session-manager-test--id parent)
                     (plist-get (gptel-agent-session--read child-id) :parent))))))

(ert-deftest gptel-agent-session-checkpoint-deletion-cancels-pending-family ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *delete-pending-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *delete-pending-child*")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-checkpoint-test--append parent " new")
      (gptel-agent-session-checkpoint-test--append child " new")
      (gptel-agent-session--drain)
      (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
      (should-not (gptel-agent-session--catalog))
      (gptel-agent-session--drain t)
      (gptel-agent-session-save)
      (should-not (gptel-agent-session--catalog))
      (should (= 0 (hash-table-count gptel-agent-session--transactions)))
      (should-not (directory-files-recursively gptel-agent-session-directory "\\.eld\\'")))))

(ert-deftest gptel-agent-session-checkpoint-unchanged-members-reuse-their-versions ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *reuse-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *reuse-child*"))
           (write (symbol-function 'gptel-agent-session--write)) before written)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq before (gptel-agent-session--file (gptel-agent-session-manager-test--id parent)))
      (gptel-agent-session-checkpoint-test--append child " changed")
      (cl-letf (((symbol-function 'gptel-agent-session--write)
                 (lambda (record) (push (plist-get record :id) written) (funcall write record))))
        (gptel-agent-session-save))
      (should (equal (list (gptel-agent-session-manager-test--id child)) written))
      (should (equal before (gptel-agent-session--file (gptel-agent-session-manager-test--id parent)))))))

(ert-deftest gptel-agent-session-checkpoint-missing-member-fails-before-restoring ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *missing-member-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *missing-member-child*"))
           root-id child-file)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq root-id (gptel-agent-session-manager-test--id parent)
            child-file (gptel-agent-session--file (gptel-agent-session-manager-test--id child)))
      ;; Normal shutdown flushes first; removing a committed member afterward
      ;; represents external corruption, not incomplete pending writes.
      (gptel-agent-session-test--forget child parent)
      (delete-file child-file)
      (let ((before (buffer-list)))
        (should-error (gptel-agent-session-restore root-id))
        (should (equal before (buffer-list)))))))

(ert-deftest gptel-agent-session-checkpoint-legacy-known-family-migrates ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *legacy-parent*" "Legacy parent"))
           (child (gptel-agent-session-manager-test--child parent " *legacy-child*"))
           records root-id)
      (gptel-agent-session-mode 1)
      (setq root-id (gptel-agent-session-manager-test--id parent))
      (dolist (buffer (list parent child))
        (push (with-current-buffer buffer (gptel-agent-session--snapshot)) records))
      ;; Seed the old header + payload representation explicitly, without
      ;; calling the new save path or publishing any family manifest.
      (dolist (record records)
        (let ((coding-system-for-write 'utf-8-emacs)
              (print-length nil) (print-level nil) (print-escape-newlines t))
          (with-temp-file (expand-file-name (concat (plist-get record :id) ".eld")
                                            gptel-agent-session-directory)
            (prin1 (list :version 1 :id (plist-get record :id)
                         :parent (plist-get record :parent) :name (plist-get record :name)
                         :updated (plist-get record :updated)) (current-buffer))
            (insert "\n") (prin1 record (current-buffer)) (insert "\n"))))
      (gptel-agent-session-store--forget gptel-agent-session-directory)
      (should (= 2 (length (gptel-agent-session--catalog))))
      (should (equal "Legacy parent" (gptel-agent-session-checkpoint-test--text parent)))
      (gptel-agent-session-save)
      (should (file-exists-p (expand-file-name (concat "families/" root-id ".eld")
                                             gptel-agent-session-directory)))
      (should (= 2 (length (gptel-agent-session--catalog))))
      (gptel-agent-session-manager-test--delete root-id)
      (should-not (gptel-agent-session--catalog)))))

(ert-deftest gptel-agent-session-checkpoint-reenabling-retains-staged-killed-members ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *reenable-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *reenable-child*"))
           child-id child-text)
      (gptel-agent-session-mode 1)
      (setq child-id (gptel-agent-session-manager-test--id child)
            child-text (with-current-buffer child (buffer-string)))
      ;; The child's last version is staged, but its initial parent has not
      ;; been written and there is no committed family yet.
      (kill-buffer child)
      (should-not (gptel-agent-session--catalog))
      (should (= 1 (hash-table-count gptel-agent-session--transactions)))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (should (= 2 (length (gptel-agent-session--catalog))))
      (should (equal child-text (plist-get (gptel-agent-session--read child-id) :text)))
      (should (equal (gptel-agent-session-manager-test--id parent)
                     (plist-get (gptel-agent-session--read child-id) :parent))))))

(ert-deftest gptel-agent-session-checkpoint-deletion-removes-uncommitted-killed-members ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *delete-uncommitted-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *delete-uncommitted-child*"))
           parent-id child-id)
      (gptel-agent-session-mode 1)
      (setq parent-id (gptel-agent-session-manager-test--id parent)
            child-id (gptel-agent-session-manager-test--id child))
      (kill-buffer child)
      (should-not (gptel-agent-session--catalog))
      (should (directory-files-recursively gptel-agent-session-directory "\\.eld\\'"))
      (gptel-agent-session-manager-test--delete parent-id)
      (should-not (directory-files-recursively gptel-agent-session-directory "\\.eld\\'"))
      (should-not (gethash parent-id gptel-agent-session--member-roots))
      (should-not (gethash child-id gptel-agent-session--member-roots))
      (should-not (gethash parent-id gptel-agent-session--family-members))
      (should (= 0 (hash-table-count gptel-agent-session--transactions)))
      (gptel-agent-session-save)
      (should-not (gptel-agent-session--catalog)))))

(ert-deftest gptel-agent-session-checkpoint-disabled-chat-does-not-strand-dirty-work ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *disabled-dirty-chat*" "Committed")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-checkpoint-test--append buffer " unsaved")
      (with-current-buffer buffer (setq gptel-mode nil))
      (gptel-agent-session--drain t)
      (should-not (gethash buffer gptel-agent-session--dirty))
      (should-not gptel-agent-session--queue)
      (should-not gptel-agent-session--timer)
      (should (equal "Committed" (gptel-agent-session-checkpoint-test--text buffer))))))

(ert-deftest gptel-agent-session-checkpoint-plan-error-remains-retryable ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *plan-error-chat*" "Recoverable"))
          (attempts 0))
      (gptel-agent-session-mode 1)
      (cl-letf (((symbol-function 'gptel-agent-session-checkpoint--begin)
                 (lambda (&rest _) (cl-incf attempts) (error "Simulated checkpoint planning failure"))))
        (gptel-agent-session--drain t))
      (should (= 1 attempts))
      (should (gethash buffer gptel-agent-session--dirty))
      (should (memq buffer gptel-agent-session--queue))
      (should (timerp gptel-agent-session--timer))
      (should (= 0 (hash-table-count gptel-agent-session--transactions)))
      (gptel-agent-session--drain t)
      (should (equal "Recoverable" (gptel-agent-session-checkpoint-test--text buffer)))
      (should-not gptel-agent-session--queue)
      (should-not gptel-agent-session--timer))))

(ert-deftest gptel-agent-session-checkpoint-quit-retains-interrupted-and-deferred-work ()
  (gptel-agent-session-test--with-store
    (let* ((deferred (gptel-agent-session-test--buffer " *quit-deferred*" "Deferred"))
           (interrupted (gptel-agent-session-test--buffer " *quit-interrupted*" "Interrupted"))
           (gptel-agent-session-save-interval 30)
           (clock (symbol-function 'float-time))
           (now 100.0) quit-seen)
      (cl-letf (((symbol-function 'float-time)
                 (lambda (&optional time) (if time (funcall clock time) now))))
        (gptel-agent-session-mode 1)
        (gptel-agent-session-save)
        (gptel-agent-session-checkpoint-test--append deferred " changed")
        (gptel-agent-session-checkpoint-test--append interrupted " changed")
        (with-current-buffer interrupted
          (setq gptel-agent-session--last-save 0 gptel-agent-session--last-attempt 0))
        (setq now 101.0)
        (cl-letf (((symbol-function 'gptel-agent-session--write)
                   (lambda (&rest _) (signal 'quit nil))))
          (condition-case nil (gptel-agent-session--drain) (quit (setq quit-seen t))))
        (should quit-seen)
        (should (memq deferred gptel-agent-session--queue))
        (should (gethash deferred gptel-agent-session--dirty))
        (should (gethash interrupted gptel-agent-session--dirty))
        (should (equal "Deferred" (gptel-agent-session-checkpoint-test--text deferred)))
        (should (equal "Interrupted" (gptel-agent-session-checkpoint-test--text interrupted)))
        (gptel-agent-session--drain t)
        (should (equal "Deferred changed" (gptel-agent-session-checkpoint-test--text deferred)))
        (should (equal "Interrupted changed" (gptel-agent-session-checkpoint-test--text interrupted)))
        (should-not gptel-agent-session--queue)
        (should-not gptel-agent-session--timer)))))

(ert-deftest gptel-agent-session-checkpoint-manual-save-includes-newer-staged-edits ()
  (gptel-agent-session-test--with-store
    (let* ((gptel-agent-session-batch-size 1)
           (parent (gptel-agent-session-test--buffer " *manual-flush-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *manual-flush-child*"))
           (write (symbol-function 'gptel-agent-session--write)) written)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-checkpoint-test--append parent " first revision")
      (gptel-agent-session-checkpoint-test--append child " first revision")
      (cl-letf (((symbol-function 'gptel-agent-session--write)
                 (lambda (record) (push (plist-get record :id) written) (funcall write record))))
        (should (= 1 (gptel-agent-session--drain)))
        (let ((staged (cl-find (car written) (list parent child)
                               :key #'gptel-agent-session-manager-test--id :test #'equal)))
          (should staged)
          (gptel-agent-session-checkpoint-test--append staged " newest revision")
          ;; The explicit command must finish the existing generation and then
          ;; include edits already present when the command was invoked.
          (gptel-agent-session-save)
          (should (string-suffix-p " first revision newest revision"
                                   (gptel-agent-session-checkpoint-test--text staged)))
          (should (= 3 (length written)))
          (should (= 0 (hash-table-count gptel-agent-session--dirty)))
          (should (= 0 (hash-table-count gptel-agent-session--transactions)))
          (should-not gptel-agent-session--timer))))))

(ert-deftest gptel-agent-session-checkpoint-manual-save-defers-edits-arriving-during-write ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *manual-new-arrivals*" "Committed"))
          (write (symbol-function 'gptel-agent-session--write)) (writes 0))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-checkpoint-test--append buffer " before manual save")
      (cl-letf (((symbol-function 'gptel-agent-session--write)
                 (lambda (record)
                   (cl-incf writes)
                   (when (> writes 2) (error "Manual save must not chase continuous edits"))
                   (funcall write record)
                   (gptel-agent-session-checkpoint-test--append buffer " arrived during write"))))
        (gptel-agent-session-save))
      (should (= 1 writes))
      (should (equal "Committed before manual save"
                     (gptel-agent-session-checkpoint-test--text buffer)))
      (should (gethash buffer gptel-agent-session--dirty))
      (should (timerp gptel-agent-session--timer))
      (gptel-agent-session-save)
      (should (equal "Committed before manual save arrived during write"
                     (gptel-agent-session-checkpoint-test--text buffer)))
      (should-not gptel-agent-session--timer))))

(provide 'gptel-agent-session-checkpoint-test)
