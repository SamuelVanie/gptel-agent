;;; gptel-agent-result-retention-test.el --- Saved output budgets -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'gptel-agent)
(require 'gptel-agent-results)

(cl-defmacro gptel-agent-result-retention-test--with-resources
    ((owner root) &body body)
  "Run BODY with a disposable OWNER and real private storage under ROOT."
  (declare (indent 1))
  `(let* ((,owner (generate-new-buffer " *result-retention-owner*"))
          (,root (make-temp-file "gptel-result-retention-" t))
          (temporary-file-directory (file-name-as-directory ,root))
          (default-directory temporary-file-directory)
          (gptel-agent--tool-results-storage nil)
          (gptel-agent--saved-tool-results (make-hash-table :test #'equal))
          (gptel-agent--result-resources (make-hash-table :test #'equal))
          (gptel-agent--results-timer nil)
          (gptel-agent-result-file-limit 12)
          (gptel-agent-result-total-limit 32)
          (gptel-agent-result-count-limit 4)
          (gptel-agent-result-retention-seconds 3600))
     (unwind-protect
         (with-current-buffer ,owner ,@body)
       (when (buffer-live-p ,owner) (kill-buffer ,owner))
       (gptel-agent--results-exit-cleanup)
       (when (timerp gptel-agent--results-timer)
         (cancel-timer gptel-agent--results-timer))
       (delete-directory ,root t))))

(defun gptel-agent-result-retention-test--create (owner &optional text completed)
  "Create tracked output for OWNER, optionally TEXT and COMPLETED."
  (pcase-let ((`(,file . ,identity) (gptel-agent--create-tool-result "test")))
    (condition-case err
        (gptel-agent--result-register file identity owner)
      (error
       (gptel-agent--delete-tool-result file identity)
       (signal (car err) (cdr err))))
    (when text (gptel-agent--result-append file text))
    (when completed
      (gptel-agent--result-publish file "Extract evidence" "test"
                                   (length (or text "")) 1))
    file))

(defun gptel-agent-result-retention-test--read (file)
  "Read private FILE as UTF-8."
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents file))
    (buffer-string)))

(ert-deftest gptel-agent-results-bound-utf8-prefix-during-capture ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((gptel-agent-result-file-limit 6)
           (file (gptel-agent-result-retention-test--create owner))
           (result (gptel-agent--result-append file "é猫ab")))
      (should (equal result '(:bytes 6 :truncated t :written 3)))
      (should (= (file-attribute-size (file-attributes file)) 6))
      (should (equal (gptel-agent-result-retention-test--read file) "é猫a"))
      ;; Even freeing/increasing capacity must not introduce a gap in the log.
      (setf (plist-get (gptel-agent--result-resource file) :limit) 30)
      (gptel-agent--result-append file "later")
      (should (equal (gptel-agent-result-retention-test--read file) "é猫a"))
      (gptel-agent--result-publish file "Extract evidence" "test" 9 1)
      (should (plist-get (gethash file gptel-agent--saved-tool-results) :truncated))
      (should (= (plist-get (gethash file gptel-agent--saved-tool-results) :bytes) 6)))))

(ert-deftest gptel-agent-results-global-byte-budget-covers-active-spools ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((gptel-agent-result-total-limit 8)
           (other (generate-new-buffer " *other-result-owner*"))
           (first (gptel-agent-result-retention-test--create owner "12345"))
           second)
      (unwind-protect
          (progn
            (setq second (gptel-agent-result-retention-test--create other "abcdef"))
            (should (= (gptel-agent--results-bytes) 8))
            (should (equal (gptel-agent-result-retention-test--read first) "12345"))
            (should (equal (gptel-agent-result-retention-test--read second) "abc"))
            (should (plist-get (gptel-agent--result-resource second) :truncated))
            (gptel-agent--result-forget first)
            (gptel-agent--result-append second "suffix")
            (should (equal (gptel-agent-result-retention-test--read second) "abc")))
        (kill-buffer other)))))

(ert-deftest gptel-agent-results-evict-oldest-completed-file-and-contract ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((gptel-agent-result-count-limit 2)
           (first (gptel-agent-result-retention-test--create owner "old" t))
           (second (gptel-agent-result-retention-test--create owner "new" t)))
      (setf (plist-get (gptel-agent--result-resource first) :access) (- (float-time) 20))
      (gptel-agent-result-retention-test--create owner "next")
      (should-not (file-exists-p first))
      (should-not (gethash first gptel-agent--saved-tool-results))
      (should (file-exists-p second))
      (should (= (hash-table-count gptel-agent--result-resources) 2)))))

(ert-deftest gptel-agent-results-protect-active-and-pinned-files-from-admission ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((gptel-agent-result-count-limit 2)
           (active (gptel-agent-result-retention-test--create owner "running"))
           (saved (gptel-agent-result-retention-test--create owner "saved" t))
           (explorer (generate-new-buffer " *result-retention-explorer*")))
      (unwind-protect
          (progn
            (gptel-agent--result-pin saved explorer)
            (should-error (gptel-agent-result-retention-test--create owner))
            (should (= (length (directory-files
                                (gptel-agent--tool-results-directory) nil "\\.txt\\'")) 2))
            (should (file-exists-p active))
            (should (file-exists-p saved))
            (gptel-agent--result-unpin saved explorer)
            (gptel-agent-result-retention-test--create owner)
            (should-not (file-exists-p saved))
            (should (file-exists-p active)))
        (kill-buffer explorer)))))

(ert-deftest gptel-agent-results-expire-unpinned-results-on-access ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((file (gptel-agent-result-retention-test--create owner "old" t))
           (active (gptel-agent-result-retention-test--create owner "running"))
           (old (- (float-time) 4000)))
      (setf (plist-get (gptel-agent--result-resource file) :access) old
            (plist-get (gptel-agent--result-resource active) :access) old)
      (should-error (gptel-agent--result-touch file))
      (should-not (file-exists-p file))
      (should-not (gethash file gptel-agent--saved-tool-results))
      (should (file-exists-p active)))))

(ert-deftest gptel-agent-results-owner-close-defers-final-pinned-file ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((file (gptel-agent-result-retention-test--create owner "saved" t))
           (unpinned (gptel-agent-result-retention-test--create owner "other" t))
           (explorer (generate-new-buffer " *result-retention-explorer*"))
           (search (generate-new-buffer " *result-retention-search*")))
      (unwind-protect
          (progn
            (gptel-agent--result-pin file explorer)
            (gptel-agent--result-pin file search)
            ;; Mode changes must not discard resource cleanup hooks.
            (text-mode)
            (kill-buffer owner)
            (should-not (file-exists-p unpinned))
            (should (file-exists-p file))
            (should (gethash file gptel-agent--saved-tool-results))
            (should-not (plist-get (gptel-agent--result-resource file) :owner))
            (gptel-agent--result-unpin file explorer)
            (should (file-exists-p file))
            (kill-buffer search)
            (should-not (file-exists-p file))
            (should (zerop (hash-table-count gptel-agent--saved-tool-results)))
            (should (zerop (hash-table-count gptel-agent--result-resources)))
            (should-not gptel-agent--results-timer))
        (when (buffer-live-p explorer) (kill-buffer explorer))
        (when (buffer-live-p search) (kill-buffer search))))))

(ert-deftest gptel-agent-results-repeated-completions-stay-bounded ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let ((gptel-agent-result-count-limit 3)
          (gptel-agent-result-total-limit 9)
          (unrelated (expand-file-name "unrelated" (gptel-agent--tool-results-directory))))
      (with-temp-file unrelated (insert "untouched"))
      (dotimes (_ 30)
        (gptel-agent-result-retention-test--create owner "five!" t)
        (should (<= (gptel-agent--results-bytes) 9))
        (should (<= (hash-table-count gptel-agent--result-resources) 3))
        (should (<= (hash-table-count gptel-agent--saved-tool-results) 3)))
      (gptel-agent--results-exit-cleanup)
      (should (equal (gptel-agent-result-retention-test--read unrelated) "untouched"))
      (should (zerop (hash-table-count gptel-agent--saved-tool-results)))
      (should (zerop (hash-table-count gptel-agent--result-resources))))))

(ert-deftest gptel-agent-results-truncated-log-still-rejects-path-substitution ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((gptel-agent-result-file-limit 1)
           (file (gptel-agent-result-retention-test--create owner "abc"))
           (original (expand-file-name "original" root)))
      (rename-file file original)
      (with-temp-file file (insert "replacement"))
      (set-file-modes file #o600)
      (should-error (gptel-agent--result-append file "ignored"))
      (should-error (gptel-agent--result-publish file "query" "test" 10 1))
      (gptel-agent--result-forget file)
      (should (equal (gptel-agent-result-retention-test--read file) "replacement"))
      (should (equal (gptel-agent-result-retention-test--read original) "a")))))

(ert-deftest gptel-agent-results-reject-invalid-and-disabled-limits ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (dolist (option '(gptel-agent-result-file-limit gptel-agent-result-total-limit
                      gptel-agent-result-count-limit gptel-agent-result-retention-seconds))
      (cl-progv (list option) (list -1)
        (should-error (gptel-agent-result-retention-test--create owner))))
    (let ((gptel-agent-result-count-limit 0))
      (should-error (gptel-agent-result-retention-test--create owner)))
    (let* ((gptel-agent-result-file-limit 0)
           (file (gptel-agent-result-retention-test--create owner "content" t)))
      (should (zerop (file-attribute-size (file-attributes file))))
      (should (plist-get (gethash file gptel-agent--saved-tool-results) :truncated)))))

(ert-deftest gptel-agent-results-failed-deletion-keeps-charging-disk-quota ()
  (gptel-agent-result-retention-test--with-resources (owner root)
    (let* ((gptel-agent-result-count-limit 1)
           (file (gptel-agent-result-retention-test--create owner "evidence" t))
           (delete (symbol-function 'delete-file)))
      (cl-letf (((symbol-function 'delete-file)
                 (lambda (path &optional trash)
                   (if (equal path file)
                       (signal 'file-error '("Simulated deletion failure"))
                     (funcall delete path trash)))))
        (gptel-agent--result-forget file)
        (should (file-exists-p file))
        (should (= (gptel-agent--results-bytes) 8))
        (should (= (hash-table-count gptel-agent--result-resources) 1))
        (should-not (gethash file gptel-agent--saved-tool-results))
        (should-error (gptel-agent-result-retention-test--create owner)))
      (gptel-agent--results-prune)
      (should-not (file-exists-p file))
      (should (zerop (hash-table-count gptel-agent--result-resources))))))

(provide 'gptel-agent-result-retention-test)
;;; gptel-agent-result-retention-test.el ends here
