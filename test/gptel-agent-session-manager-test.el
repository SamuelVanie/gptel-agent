;;; gptel-agent-session-manager-test.el --- Saved session management -*- lexical-binding: t; -*-

(require 'ert)
(require 'gptel-agent-session-test)

(defun gptel-agent-session-manager-test--child (owner name)
  "Create an idle ordinary discussion named NAME belonging to OWNER."
  (let* ((buffer (gptel-agent-session-test--buffer name (concat name " transcript")))
         (chat (gptel-agent-discussion--make-chat
                :id (gptel-agent-discussion--id "discussion") :title name
                :owner owner :buffer buffer)))
    (with-current-buffer buffer
      (setq gptel-agent-discussion--self chat gptel-agent--child-chat-p t)
      (add-hook 'kill-buffer-hook #'gptel-agent-discussion--kill nil t))
    (with-current-buffer owner
      (push chat gptel-agent-discussion--children)
      (add-hook 'kill-buffer-hook #'gptel-agent-discussion--kill nil t))
    (gptel-agent-session--created chat)
    buffer))

(defun gptel-agent-session-manager-test--id (buffer)
  "Return BUFFER's persistent session ID."
  (buffer-local-value 'gptel-agent-session--id buffer))

(defun gptel-agent-session-manager-test--delete (id)
  "Confirm deletion of the family containing ID."
  (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
    (gptel-agent-session-delete id)))

(defun gptel-agent-session-manager-test--spawn-nested (fsm parent)
  "Spawn real child and grandchild discussions from FSM in PARENT."
  (let* ((chat (gptel-agent-discussion-test--spawn fsm parent))
         (child (gptel-agent-discussion--chat-buffer chat))
         (child-fsm (gptel-agent-discussion--chat-fsm chat)))
    (gptel-agent-discussion-test--spawn child-fsm child "Nested management task")
    (when-let* ((pending (car (gptel-agent-discussion--chat-pending chat))))
      (gptel--accept-tool-calls (gptel-agent-discussion--interaction-calls pending)))
    (list child (gptel-agent-discussion--chat-buffer
                 (car (buffer-local-value 'gptel-agent-discussion--children child))))))

(ert-deftest gptel-agent-session-manager-deletes-whole-family-only ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *delete-parent*" "Parent transcript"))
           (child (gptel-agent-session-manager-test--child parent " *delete-child*"))
           (grandchild (gptel-agent-session-manager-test--child child " *delete-grandchild*"))
           (other (gptel-agent-session-test--buffer " *keep-unrelated*" "Unrelated transcript"))
           (chat (buffer-local-value 'gptel-agent-discussion--self child))
           (text (with-current-buffer child (buffer-string)))
           confirmations)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (prompt) (push prompt confirmations) t)))
        ;; Passing a nested chat's ID has the same family semantics as restore.
        (gptel-agent-session-delete (gptel-agent-session-manager-test--id grandchild)))
      (should (= 1 (length confirmations)))
      (dolist (buffer (list parent child grandchild))
        (should (buffer-live-p buffer))
        (should (buffer-local-value 'gptel-agent-session--excluded buffer))
        (should-not (file-exists-p (gptel-agent-session--file
                                   (gptel-agent-session-manager-test--id buffer)))))
      (should (equal text (with-current-buffer child (buffer-string))))
      (should (eq parent (gptel-agent-discussion--chat-owner chat)))
      (should (eq chat (buffer-local-value 'gptel-agent-discussion--self child)))
      (should (file-exists-p (gptel-agent-session--file
                             (gptel-agent-session-manager-test--id other))))
      (should-not (buffer-local-value 'gptel-agent-session--excluded other))
      (should (eq t (file-locked-p gptel-agent-session--lock))))))

(ert-deftest gptel-agent-session-manager-cancelling-deletion-keeps-snapshots ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *cancel-delete*" "Keep me"))
          asked)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (let* ((id (gptel-agent-session-manager-test--id buffer))
             (before (gptel-agent-session--read id)))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (&rest _) (setq asked t) nil)))
          (condition-case nil (gptel-agent-session-delete id) (user-error nil)))
        (should asked)
        (should (equal before (gptel-agent-session--read id)))
        (should-not (buffer-local-value 'gptel-agent-session--excluded buffer))
        (should (eq buffer (gethash id gptel-agent-session--buffers)))))))

(ert-deftest gptel-agent-session-manager-deleted-live-chats-stay-unsaved ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *excluded-parent*" "Before"))
           (child (gptel-agent-session-manager-test--child parent " *excluded-child*")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
      (with-current-buffer child (goto-char (point-max)) (insert " edited"))
      (with-current-buffer parent
        (org-mode)
        (gptel-mode 1)
        (goto-char (point-max)) (insert " after mode change"))
      (gptel-agent-session-save)
      (should-not (gptel-agent-session--catalog))
      (dolist (buffer (list parent child))
        (should-not (gethash buffer gptel-agent-session--dirty))
        (should-not (gethash (gptel-agent-session-manager-test--id buffer)
                             gptel-agent-session--buffers)))
      (gptel-agent-session-mode -1)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (should-not (gptel-agent-session--catalog))
      (kill-buffer child)
      (kill-buffer parent)
      (should-not (gptel-agent-session--catalog)))))

(ert-deftest gptel-agent-session-manager-prefix-save-reincludes-family ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *include-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *include-child*")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
      (should-not (gptel-agent-session--catalog))
      (with-current-buffer child (gptel-agent-session-save t))
      (dolist (buffer (list parent child))
        (should-not (buffer-local-value 'gptel-agent-session--excluded buffer))
        (should (file-exists-p (gptel-agent-session--file
                               (gptel-agent-session-manager-test--id buffer)))))
      (should (equal (gptel-agent-session-manager-test--id parent)
                     (plist-get (gptel-agent-session--read
                                 (gptel-agent-session-manager-test--id child)) :parent))))))

(ert-deftest gptel-agent-session-manager-deletion-covers-unsaved-descendants ()
  (gptel-agent-session-test--with-store
    (let ((parent (gptel-agent-session-test--buffer " *unsaved-parent*" "Parent")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (let* ((child (gptel-agent-session-manager-test--child parent " *unsaved-child*"))
             (grandchild (gptel-agent-session-manager-test--child child " *unsaved-grandchild*")))
        (should-not (file-exists-p (gptel-agent-session--file
                                   (gptel-agent-session-manager-test--id child))))
        (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
        (dolist (buffer (list parent child grandchild))
          (should (buffer-local-value 'gptel-agent-session--excluded buffer))
          (should-not (gethash buffer gptel-agent-session--dirty)))
        (gptel-agent-session-save)
        (should-not (gptel-agent-session--catalog))))))

(ert-deftest gptel-agent-session-manager-new-discussions-inherit-exclusion ()
  (gptel-agent-session-test--with-store
    (gptel-agent-discussion-test--with-chat
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
      (setq chat (gptel-agent-discussion-test--spawn fsm parent))
      (let ((child (gptel-agent-discussion--chat-buffer chat)))
        (should (buffer-live-p child))
        (should (gptel-agent-discussion--active-p (gptel-agent-discussion--chat-fsm chat)))
        (should (buffer-local-value 'gptel-agent-session--excluded child))
        (should-not (gethash child gptel-agent-session--dirty))
        (gptel-agent-session-save)
        (should-not (gptel-agent-session--catalog))))))

(ert-deftest gptel-agent-session-manager-rechecks-descendants-after-confirmation ()
  (gptel-agent-session-test--with-store
    (let ((parent (gptel-agent-session-test--buffer " *prompt-parent*" "Parent")) child)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (&rest _)
                   ;; Timers and tool completions may run while a real prompt
                   ;; waits for input, creating another owned discussion.
                   (setq child (gptel-agent-session-manager-test--child parent " *during-prompt*"))
                   t)))
        (gptel-agent-session-delete (gptel-agent-session-manager-test--id parent)))
      (should (buffer-live-p child))
      (should (buffer-local-value 'gptel-agent-session--excluded child))
      (gptel-agent-session-save)
      (should-not (gptel-agent-session--catalog)))))

(ert-deftest gptel-agent-session-manager-deletes-with-mode-off-without-enabling-it ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *mode-off-delete*" "Archived")) id)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq id (gptel-agent-session-manager-test--id buffer))
      (gptel-agent-session-mode -1)
      (kill-buffer buffer)
      (let ((create-lockfiles nil))
        (gptel-agent-session-manager-test--delete id))
      (should-not gptel-agent-session-mode)
      (should-not gptel-agent-session--timer)
      (should-not (gptel-agent-session--catalog))
      (should-not (file-locked-p (expand-file-name ".writer" gptel-agent-session-directory))))))

(ert-deftest gptel-agent-session-manager-mode-off-delete-excludes-live-buffers ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *off-live-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *off-live-child*")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-mode -1)
      (should (= 0 (hash-table-count gptel-agent-session--buffers)))
      (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
      (should-not gptel-agent-session-mode)
      (dolist (buffer (list parent child))
        (should (buffer-local-value 'gptel-agent-session--excluded buffer)))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (should-not (gptel-agent-session--catalog)))))

(ert-deftest gptel-agent-session-manager-mode-off-delete-excludes-untracked-descendants ()
  (gptel-agent-session-test--with-store
    (gptel-agent-discussion-test--with-chat
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-mode -1)
      (let ((descendants (gptel-agent-session-manager-test--spawn-nested fsm parent)))
        (dolist (buffer descendants)
          (should-not (gptel-agent-session-manager-test--id buffer)))
        (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
        (dolist (buffer descendants)
          (should (buffer-local-value 'gptel-agent-session--excluded buffer)))
        ;; Killing the parent destroys the runtime link from each direct child
        ;; to the root; exclusion must already have reached the whole tree.
        (kill-buffer parent)
        (gptel-agent-session-mode 1)
        (gptel-agent-session-save)
        (dolist (buffer descendants)
          (should (buffer-live-p buffer))
          (should (buffer-local-value 'gptel-agent-session--excluded buffer))
          (should-not (gethash buffer gptel-agent-session--dirty)))
        (should-not (gptel-agent-session--catalog))))))

(ert-deftest gptel-agent-session-manager-reenable-excludes-new-descendants-before-tracking ()
  (gptel-agent-session-test--with-store
    (gptel-agent-discussion-test--with-chat
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-manager-test--delete (gptel-agent-session-manager-test--id parent))
      (gptel-agent-session-mode -1)
      (let* ((descendants (gptel-agent-session-manager-test--spawn-nested fsm parent))
             (newest-first (append (reverse descendants) (list parent)))
             (original-buffer-list (symbol-function 'buffer-list)))
        (dolist (buffer descendants)
          (should-not (gptel-agent-session-manager-test--id buffer)))
        ;; A single pass that visits grandchild before child before parent
        ;; cannot propagate the exclusion far enough before registering them.
        (cl-letf (((symbol-function 'buffer-list)
                   (lambda (&optional frame)
                     (append newest-first
                             (cl-remove-if (lambda (buffer) (memq buffer newest-first))
                                           (funcall original-buffer-list frame))))))
          (gptel-agent-session-mode 1))
        (gptel-agent-session-save)
        (dolist (buffer descendants)
          (should (buffer-local-value 'gptel-agent-session--excluded buffer))
          (should-not (gethash buffer gptel-agent-session--dirty))
          (should-not (gethash (gptel-agent-session-manager-test--id buffer)
                               gptel-agent-session--buffers)))
        (should-not (gptel-agent-session--catalog))))))

(ert-deftest gptel-agent-session-manager-refuses-another-writer ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *locked-delete*" "Keep me")))
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-mode -1)
      (let* ((id (gptel-agent-session-manager-test--id buffer))
             (before (gptel-agent-session--read id)))
        (cl-letf (((symbol-function 'file-locked-p) (lambda (&rest _) "another-user@host"))
                  ((symbol-function 'lock-file) (lambda (&rest _) (ert-fail "Must not steal another writer's lock"))))
          (should-error (gptel-agent-session-manager-test--delete id) :type 'user-error))
        (should (equal before (gptel-agent-session--read id)))
        (should-not (buffer-local-value 'gptel-agent-session--excluded buffer))
        (should-not gptel-agent-session-mode)))))

(ert-deftest gptel-agent-session-manager-failed-stage-restores-the-whole-family ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *rollback-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *rollback-child*"))
           (original-rename (symbol-function 'rename-file))
           (moves 0) ids before)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq ids (mapcar #'gptel-agent-session-manager-test--id (list parent child))
            before (mapcar #'gptel-agent-session--read ids))
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (old new &optional replace)
                   (when (and (equal (file-name-directory old) gptel-agent-session-directory)
                              (string-suffix-p ".eld" old))
                     (cl-incf moves)
                     (when (= moves 2) (signal 'file-error '("Simulated staging failure"))))
                   (funcall original-rename old new replace))))
        (should-error (gptel-agent-session-manager-test--delete (car ids)) :type 'file-error))
      (should (= moves 2))
      (should (equal before (mapcar #'gptel-agent-session--read ids)))
      (dolist (buffer (list parent child))
        (should-not (buffer-local-value 'gptel-agent-session--excluded buffer))
        (should (eq buffer (gethash (gptel-agent-session-manager-test--id buffer)
                                   gptel-agent-session--buffers)))))))

(ert-deftest gptel-agent-session-manager-quit-during-stage-restores-the-whole-family ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *quit-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *quit-child*"))
           (original-rename (symbol-function 'rename-file))
           (moves 0) ids before quit-seen)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (setq ids (mapcar #'gptel-agent-session-manager-test--id (list parent child))
            before (mapcar #'gptel-agent-session--read ids))
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (old new &optional replace)
                   (when (and (equal (file-name-directory old) gptel-agent-session-directory)
                              (string-suffix-p ".eld" old))
                     (cl-incf moves)
                     (when (= moves 2) (signal 'quit nil)))
                   (funcall original-rename old new replace))))
        (condition-case nil
            (gptel-agent-session-manager-test--delete (car ids))
          (quit (setq quit-seen t))))
      (should quit-seen)
      (should (= moves 2))
      (should (equal before (mapcar #'gptel-agent-session--read ids)))
      (dolist (buffer (list parent child))
        (should-not (buffer-local-value 'gptel-agent-session--excluded buffer))
        (should (eq buffer (gethash (gptel-agent-session-manager-test--id buffer)
                                   gptel-agent-session--buffers)))))))

(ert-deftest gptel-agent-session-manager-lists-headers-only-without-enabling-saving ()
  (gptel-agent-session-test--with-store
    (let* ((parent (gptel-agent-session-test--buffer " *browse-parent*" "Parent"))
           (child (gptel-agent-session-manager-test--child parent " *browse-child*"))
           (other (gptel-agent-session-test--buffer " *browse-other*" "Other"))
           (original-read (symbol-function 'gptel-agent-session--read))
           manager reads)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-mode -1)
      (cl-letf (((symbol-function 'gptel-agent-session--read)
                 (lambda (id &optional header-only)
                   (should header-only)
                   (push id reads)
                   (funcall original-read id header-only)))
                ((symbol-function 'gptel-send) (lambda (&rest _) (ert-fail "Unexpected request")))
                ((symbol-function 'pop-to-buffer)
                 (lambda (buffer &rest _) (setq manager (get-buffer buffer)) manager)))
        (gptel-agent-sessions))
      (should-not gptel-agent-session-mode)
      (should-not gptel-agent-session--timer)
      (should reads)
      (should (buffer-live-p manager))
      (with-current-buffer manager
        (should (derived-mode-p 'gptel-agent-sessions-mode))
        (should (equal gptel-agent-session-directory gptel-agent-session--list-directory))
        (should (= 2 (length tabulated-list-entries)))
        (let ((parent-row (assoc (gptel-agent-session-manager-test--id parent) tabulated-list-entries)))
          (should parent-row)
          (should (equal "2" (aref (cadr parent-row) 1))))
        (should (assoc (gptel-agent-session-manager-test--id other) tabulated-list-entries))
        (should-not (assoc (gptel-agent-session-manager-test--id child) tabulated-list-entries))
        (should (eq #'gptel-agent-session-open (lookup-key (current-local-map) (kbd "RET"))))
        (should (eq #'gptel-agent-session-delete (lookup-key (current-local-map) (kbd "d"))))))))

(ert-deftest gptel-agent-session-manager-rejects-stale-directory-rows ()
  (gptel-agent-session-test--with-store
    (let ((buffer (gptel-agent-session-test--buffer " *stale-store*" "Keep me")) manager)
      (gptel-agent-session-mode 1)
      (gptel-agent-session-save)
      (gptel-agent-session-mode -1)
      (cl-letf (((symbol-function 'pop-to-buffer)
                 (lambda (target &rest _) (setq manager (get-buffer target)) manager)))
        (gptel-agent-sessions))
      (let ((gptel-agent-session-directory (make-temp-file "gptel-other-session-store-" t)))
        (unwind-protect
            (with-current-buffer manager
              (cl-letf (((symbol-function 'yes-or-no-p)
                         (lambda (&rest _) (ert-fail "Stale rows must fail before deletion confirmation")))
                        ((symbol-function 'gptel-agent-session-restore)
                         (lambda (&rest _) (ert-fail "Stale rows must not restore another store"))))
                (should-error (gptel-agent-session-open) :type 'user-error)
                (should-error (call-interactively #'gptel-agent-session-delete) :type 'user-error)))
          (delete-directory gptel-agent-session-directory t)))
      (should (file-exists-p (gptel-agent-session--file
                             (gptel-agent-session-manager-test--id buffer)))))))

(provide 'gptel-agent-session-manager-test)
