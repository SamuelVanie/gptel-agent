;;; gptel-agent-history-test.el --- Snapshot and live review tests -*- lexical-binding: t; -*-

(require 'gptel-agent-review-test)

(ert-deftest gptel-review-live-edits-are-testable-before-acceptance ()
  (gptel-review-test--with-files '(("check.sh" . "exit 9\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (let ((call (gptel-review-test--submit
                   "Edit" '(:path "check.sh" :old_str "exit 9" :new_str "printf 'verified\\n'"))))
        (should-not (plist-get call :error))
        (should (string-match-p "Applied changes" (plist-get call :result))))
      (should (eq (plist-get (gptel-review-test--file 1) :status) 'pending))
      (let (result)
        (let ((process (gptel-agent--execute-bash
                        (lambda (output) (setq result output))
                        "bash -n check.sh && bash check.sh" "Did the script pass?")))
          (while (process-live-p process) (accept-process-output process 0.1))
          (accept-process-output process 0.1))
        (should (equal result "verified\n")))
      (gptel-review-test--open 1)
      (let ((view (gptel-agent-review--queue-view gptel-agent-review--queue)))
        (should (equal (smv/gptel-ediff--view-before view) "exit 9\n")))
      (gptel-edit-test--key "q")
      (gptel-review-test--in-queue (gptel-agent-review-done))
      (should-not outcomes)
      (should-not gptel-agent-review--queue)
      (should (= 1 (length (gptel-agent-history--entries)))))))

(ert-deftest gptel-review-live-refusal-restores-cumulative-original ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "other\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "draft"))
      (gptel-review-test--submit "Insert" '(:path "one" :line_number -1 :new_str "tail"))
      (gptel-review-test--submit "Edit" '(:path "two" :old_str "other" :new_str "changed"))
      (gptel-agent-review--cancel gptel-agent-review--queue (gptel-review-test--file 1) "Keep behavior")
      (should (equal (gptel-edit-test--read "one") "old\n"))
      (should (equal (gptel-edit-test--read "two") "changed\n"))
      (should (string-match-p "restored" (cadar outcomes)))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "fixed"))
      (should (equal (plist-get (gptel-review-test--file 1) :before) "old\n"))
      (gptel-review-test--in-queue (gptel-agent-review-accept-all) (gptel-agent-review-done))
      (should (= 1 (length outcomes)))
      (should (equal (gptel-edit-test--read "one") "fixed\n")))))

(ert-deftest gptel-review-live-cancel-restores-created-deleted-and-empty-files ()
  (gptel-review-test--with-files '(("one" . "old\n") ("empty" . ""))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit
       "Edit" '(:path "." :operations [(:operation "delete" :path "one")
                                       (:operation "write" :path "empty" :content "filled")
                                       (:operation "write" :path "nested/new" :content "")]))
      (should-not (file-exists-p "one"))
      (should (file-exists-p "nested/new"))
      (gptel-review-test--in-queue (gptel-agent-review-cancel-all))
      (should (equal (gptel-edit-test--read "one") "old\n"))
      (should (equal (gptel-edit-test--read "empty") ""))
      (should-not (file-exists-p "nested/new"))
      (should-not gptel-agent-review--queue))))

(ert-deftest gptel-review-live-conflicts-never-overwrite-user-changes ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (dolist (path '("one" "two"))
        (gptel-review-test--submit "Edit" (list :path path :old_str "old" :new_str "new")))
      (with-temp-file "two" (insert "user edit\n"))
      (gptel-review-test--in-queue (should-error (gptel-agent-review-cancel-all)))
      (should (equal (gptel-edit-test--read "one") "new\n"))
      (should (equal (gptel-edit-test--read "two") "user edit\n"))
      (let ((call (gptel-review-test--submit "Edit" '(:path "two" :old_str "user edit" :new_str "replacement"))))
        (should (plist-get call :error)))
      (should (equal (gptel-edit-test--read "two") "user edit\n"))
      (should gptel-agent-review--queue)
      (should-not outcomes))))

(ert-deftest gptel-review-live-write-error-keeps-disk-and-review-in-sync ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t)
          (write (symbol-function 'gptel-agent-edit--write)))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "draft"))
      (cl-letf (((symbol-function 'gptel-agent-edit--write)
                 (lambda (change content)
                   (if (equal content "fail") (error "Simulated failure")
                     (funcall write change content)))))
        (should (plist-get
                 (gptel-review-test--submit
                  "Edit" '(:path "." :operations [(:operation "write" :path "one" :content "new")
                                                  (:operation "write" :path "two" :content "fail")]))
                 :error)))
      (should (equal (gptel-edit-test--read "one") "draft\n"))
      (should (equal (gptel-edit-test--read "two") "old\n"))
      (should (= 1 (plist-get (gptel-review-test--file 1) :revision)))
      (should (= 1 (length (gptel-agent-history--entries)))))))

(ert-deftest gptel-review-live-history-cannot-restore-under-open-review ()
  (gptel-review-test--with-files '(("one" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
      (should-error (gptel-agent-history-restore (car (gptel-agent-history--entries))) :type 'user-error)
      (gptel-review-test--in-queue (gptel-agent-review-accept-all) (gptel-agent-review-done))
      (gptel-agent-history-restore (car (gptel-agent-history--entries)))
      (should (equal (gptel-edit-test--read "one") "old\n")))))

(ert-deftest gptel-review-live-other-conversation-cannot-claim-pending-file ()
  (gptel-review-test--with-files '(("one" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
      (with-temp-buffer
        (let ((call (gptel-review-test--submit "Edit" '(:path "one" :old_str "new" :new_str "other"))))
          (should (plist-get call :error))
          (should (string-match-p "Finish the review" (plist-get call :result)))))
      (should (equal (gptel-edit-test--read "one") "new\n")))))

(ert-deftest gptel-history-restores-batches-and-can-undo-a-restore ()
  (gptel-edit-test--with-files '(("one" . "original\n") ("empty" . ""))
    (set-file-modes "one" #o755)
    (gptel-agent--edit-files
     "." nil nil nil [(:operation "write" :path "one" :content "révision\n")
                      (:operation "delete" :path "empty")
                      (:operation "write" :path "created" :content "")])
    (let ((snapshot (car (gptel-agent-history--entries))))
      (should (equal (gptel-edit-test--read (expand-file-name "0-before" snapshot)) "original\n"))
      (gptel-agent-history-restore snapshot)
      (should (equal (gptel-edit-test--read "one") "original\n"))
      (should (= (file-modes "one") #o755))
      (should (equal (gptel-edit-test--read "empty") ""))
      (should-not (file-exists-p "created"))
      (gptel-agent-history-restore (car (gptel-agent-history--entries)))
      (should (equal (gptel-edit-test--read "one") "révision\n"))
      (should-not (file-exists-p "empty"))
      (should (equal (gptel-edit-test--read "created") "")))))

(ert-deftest gptel-history-restore-preserves-later-and-unsaved-edits ()
  (gptel-edit-test--with-files '(("one" . "old") ("two" . "old"))
    (gptel-agent--edit-files
     "." nil nil nil [(:operation "write" :path "one" :content "new")
                      (:operation "write" :path "two" :content "new")])
    (let ((snapshot (car (gptel-agent-history--entries)))
          (buffer (find-file-noselect "two")))
      (with-current-buffer buffer (insert "unsaved"))
      (should-error (gptel-agent-history-restore snapshot))
      (should (equal (gptel-edit-test--read "one") "new"))
      (with-current-buffer buffer (revert-buffer t t))
      (with-temp-file "two" (insert "user"))
      (should-error (gptel-agent-history-restore snapshot))
      (should (equal (gptel-edit-test--read "one") "new"))
      (should (equal (gptel-edit-test--read "two") "user")))))

(ert-deftest gptel-history-backup-failure-prevents-writes ()
  (gptel-edit-test--with-files '(("one" . "old"))
    (cl-letf (((symbol-function 'gptel-agent-history--record) (lambda (_) (error "Disk full"))))
      (should-error (gptel-agent--edit-files "one" "old" "new" nil)))
    (should (equal (gptel-edit-test--read "one") "old"))))

(ert-deftest gptel-review-acceptance-leaves-conversation-untouched ()
  (dolist (immediate '(nil t))
    (gptel-edit-test--with-files '(("one" . "old"))
      (let ((gptel-agent-review-apply-immediately immediate))
        (insert "Existing conversation")
        (cl-letf (((symbol-function 'display-buffer) (lambda (&rest _) nil))
                  ((symbol-function 'gptel-send) (lambda (&rest _) (ert-fail "Acceptance sent a prompt"))))
          (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
          (gptel-review-test--in-queue (gptel-agent-review-accept-all) (gptel-agent-review-done))
          (should-not gptel-agent-review--delivery)
          (should-not gptel-agent-review--delivery-timer)
          (should (equal (buffer-string) "Existing conversation")))))))

(ert-deftest gptel-review-feedback-sends-all-comments-once-without-active-region ()
  (with-temp-buffer
    (let (sent)
      (insert "Existing conversation")
      (setq-local mark-active t)
      (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'gptel-send)
                 (lambda (&rest _)
                   (should-not mark-active)
                   (push (buffer-string) sent))))
        (gptel-agent-review--deliver (current-buffer) "Refused one: keep compatibility" t)
        (gptel-agent-review--deliver (current-buffer) "Comment on two: keep the test" t)
        (gptel-agent-review--flush (current-buffer))
        (gptel-agent-review--flush (current-buffer))
        (should (= 1 (length sent)))
        (should (string-match-p "Refused one" (car sent)))
        (should (string-match-p "Comment on two" (car sent)))))))

(ert-deftest gptel-review-new-feedback-after-terminal-request-sends-automatically ()
  (dolist (state '(DONE ABRT ERRS))
    (with-temp-buffer
      (setq-local gptel--fsm-last (gptel-make-fsm :state state))
      (let (sent)
        (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                  ((symbol-function 'gptel-send) (lambda (&rest _) (setq sent (buffer-string)))))
          (gptel-agent-review--deliver (current-buffer) "New explicit refusal" t)
          (gptel-agent-review--flush (current-buffer))
          (should (string-match-p "New explicit refusal" sent)))))))

(ert-deftest gptel-history-browser-shows-diffs-and-restores-selected-batch ()
  (gptel-edit-test--with-files '(("one" . "old\n"))
    (gptel-agent--edit-files "one" "old" "new" nil)
    (save-window-excursion
      (unwind-protect
          (progn
            (gptel-agent-history)
            (should (derived-mode-p 'gptel-agent-history-mode))
            (should (= 1 (length tabulated-list-entries)))
            (goto-char (point-min))
            (cl-letf (((symbol-function 'completing-read) (lambda (_prompt choices &rest _) (car choices))))
              (gptel-agent-history-diff))
            (with-current-buffer "*Diff*"
              (should (string-match-p "-old" (buffer-string)))
              (should (string-match-p "+new" (buffer-string))))
            (with-current-buffer "*Agent file history*"
              (call-interactively #'gptel-agent-history-restore)
              (should (= 2 (length tabulated-list-entries))))
            (should (equal (gptel-edit-test--read "one") "old\n")))
        (when (get-buffer "*Agent file history*") (kill-buffer "*Agent file history*"))
        (when (get-buffer "*Diff*") (kill-buffer "*Diff*"))))))

(ert-deftest gptel-history-restores-file-encoding ()
  (gptel-edit-test--with-files nil
    (let ((coding-system-for-write 'utf-8-dos))
      (with-temp-file "one" (insert "café\n")))
    (gptel-agent--edit-files "one" "café" "thé" nil)
    (gptel-agent-history-restore (car (gptel-agent-history--entries)))
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert-file-contents-literally "one")
      (should (equal (buffer-string) (encode-coding-string "café\n" 'utf-8-dos))))))

(ert-deftest gptel-review-live-refusal-during-preparation-cannot-be-overwritten ()
  (gptel-review-test--with-files '(("one" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "draft"))
      (let ((prepare (symbol-function 'gptel-agent-edit-prepare)))
        (cl-letf (((symbol-function 'gptel-agent-edit-prepare)
                   (lambda (name args)
                     (prog1 (funcall prepare name args)
                       (gptel-agent-review--cancel gptel-agent-review--queue (gptel-review-test--file 1) "Refused")))))
          (should (plist-get (gptel-review-test--submit "Write" '(:path "." :filename "one" :content "new")) :error))))
      (should (equal (gptel-edit-test--read "one") "old\n"))
      (should (eq (plist-get (gptel-review-test--file 1) :status) 'cancelled)))))

(provide 'gptel-agent-history-test)
