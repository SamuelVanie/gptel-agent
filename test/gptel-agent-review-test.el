(ert-deftest gptel-review-idle-feedback-sends-once-and-acceptance-does-not-send ()
  (dolist (revise '(nil t))
    (with-temp-buffer
      (let (sent)
        (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                  ((symbol-function 'gptel-send) (lambda (&rest _) (push (buffer-string) sent))))
          (gptel-agent-review--deliver (current-buffer) "Completed review" revise)
          (gptel-agent-review--flush (current-buffer))
          (gptel-agent-review--flush (current-buffer))
          (should (equal (buffer-string) "\n\nCompleted review\n"))
          (should (= (length sent) (if revise 1 0))))))))

(ert-deftest gptel-review-active-feedback-uses-native-steering-once ()
  (with-temp-buffer
    (let* ((messages nil)
           (info (list :buffer (current-buffer)
                       :backend (gptel-make-openai "Review test" :key "unused")
                       :data (list :messages [])
                       :callback (lambda (text _info &optional raw) (push (cons raw text) messages))))
           (fsm (gptel-make-fsm :state 'WAIT :info info :handlers nil
				:table '((TSTR . ((t . WAIT)))))))
      (setq-local gptel--fsm-last fsm)
      (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'gptel-send) (lambda (&rest _) (ert-fail "Duplicate request"))))
        (gptel-agent-review--deliver (current-buffer) "Review feedback" t)
        (gptel-agent-review--flush (current-buffer))
        (should (equal (plist-get (gptel-fsm-info fsm) :steering-message) '("Review feedback")))
        (setf (gptel-fsm-state fsm) 'TSTR)
        (gptel--handle-tool-steer fsm)
        (should (= 1 (length messages)))
        (should (caar messages))
        (should (string-match-p "Review feedback" (cdar messages)))
        (let* ((data (plist-get info :data))
               (prompts (or (plist-get data :input) (plist-get data :messages))))
          (should (equal (plist-get (aref prompts 0) :role) "user")))
        (setf (gptel-fsm-state fsm) 'DONE)
        (gptel-agent-review--flush (current-buffer))
        (should-not gptel-agent-review--delivery)
        (should (equal (buffer-string) ""))))))

(ert-deftest gptel-review-feedback-after-final-response-starts-followup ()
  (with-temp-buffer
    (let ((fsm (gptel-make-fsm :state 'WAIT :info (list :buffer (current-buffer)))) sent)
      (setq-local gptel--fsm-last fsm)
      (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                ((symbol-function 'gptel-send) (lambda (&rest _) (setq sent (buffer-string)))))
        (gptel-agent-review--deliver (current-buffer) "Please revise" t)
        (gptel-agent-review--flush (current-buffer))
        (should-not sent)
        (setf (gptel-fsm-state fsm) 'DONE)
        (gptel-agent-review--flush (current-buffer))
        (should (string-match-p "Please revise" sent))
        (should-not (plist-get (gptel-fsm-info fsm) :steering-message))))))

