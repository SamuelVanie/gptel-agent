;;; gptel-agent-review-test.el --- Queued review regressions -*- lexical-binding: t; -*-

(require 'gptel-agent-edit-test)
(require 'gptel-openai)

(defmacro gptel-review-test--with-files (files &rest body)
  "Run BODY with FILES, capturing completed review outcomes."
  (declare (indent 1))
  `(gptel-edit-test--with-files ,files
				(let ((ediff-window-setup-function #'ediff-setup-windows-plain)
				      outcomes)
				  (cl-letf (((symbol-function 'display-buffer) (lambda (&rest _) nil))
					    ((symbol-function 'gptel-agent-review--deliver)
					     (lambda (owner text revise) (push (list owner text revise) outcomes))))
					   ,@body))))

(defmacro gptel-review-test--in-queue (&rest body)
  "Run BODY in the current conversation's review buffer."
  `(with-current-buffer (gptel-agent-review--queue-buffer gptel-agent-review--queue)
     ,@body))

(defun gptel-review-test--submit (name args &optional confirm)
  "Dispatch NAME with ARGS through the actual prehook and tool runner."
  (gptel-edit-test--dispatch name args (if (equal name "Read") 'auto (or confirm t))))

(defun gptel-review-test--select (id)
  "Select proposal ID in the current review buffer."
  (goto-char (point-min))
  (while (and (not (eobp)) (not (equal id (tabulated-list-get-id)))) (forward-line))
  (should (equal id (tabulated-list-get-id))))

(ert-deftest gptel-review-tools-return-before-review-and-stage-dependent-edits ()
  (gptel-review-test--with-files '(("one" . "old\n"))
				 (cl-letf (((symbol-function 'recursive-edit) (lambda () (ert-fail "Tool blocked on review"))))
				   (dolist (confirm '(t auto))
				     (let ((call (gptel-review-test--submit
						  "Insert" '(:path "one" :line_number 0 :new_str "first") confirm)))
				       (should-not (plist-get call :error))
				       (should (string-match-p "NOT applied" (plist-get call :result)))))
				   (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
				   (gptel-review-test--submit "Write" '(:path "." :filename "created" :content "draft\n"))
				   (gptel-review-test--submit "Edit" '(:path "created" :old_str "draft" :new_str "final")))
				 (should (= 5 (length (gptel-agent-review--queue-proposals gptel-agent-review--queue))))
				 (should (equal (gptel-edit-test--read "one") "old\n"))
				 (should-not (file-exists-p "created"))
				 (should (equal (plist-get (gptel-review-test--submit "Read" '(:file_path "one")) :result)
						"first\nfirst\nnew\n"))
				 (gptel-review-test--in-queue
				  (should-error (gptel-agent-review-done) :type 'user-error)
				  (gptel-agent-review-accept-all)
				  (should-not outcomes)
				  (gptel-agent-review-done))
				 (should (equal (gptel-edit-test--read "one") "first\nfirst\nnew\n"))
				 (should (equal (gptel-edit-test--read "created") "final\n"))
				 (should (= 1 (length outcomes)))
				 (should-not gptel-agent-review--queue)
				 (should-not (caddar outcomes))))

(ert-deftest gptel-review-proposals-arrive-during-real-ediff ()
  (gptel-review-test--with-files '(("one" . "old\n"))
				 (let ((owner (current-buffer)))
				   (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
				   (cl-letf (((symbol-function 'recursive-edit)
					      (lambda ()
						(with-current-buffer owner
						  (gptel-review-test--submit "Insert" '(:path "one" :line_number -1 :new_str "tail\n")))
						(should (equal (gptel-edit-test--read "one") "old\n"))
						(gptel-edit-test--key "q"))))
				     (gptel-review-test--in-queue
				      (gptel-review-test--select 1)
				      (gptel-agent-review-proposal)))
				   (let ((proposals (gptel-agent-review--queue-proposals gptel-agent-review--queue)))
				     (should (equal (mapcar (lambda (p) (plist-get p :status)) proposals) '(accepted pending)))
				     (should (equal (plist-get (car (plist-get (cadr proposals) :changes)) :before) "new\n")))
				   (gptel-review-test--in-queue
				    (should-error (gptel-agent-review-done))
				    (gptel-agent-review-accept-all)
				    (gptel-agent-review-done))
				   (should (equal (gptel-edit-test--read "one") "new\ntail\n")))))

(ert-deftest gptel-review-feedback-waits-for-done-and-cancels-dependents ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "two\n"))
				 (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
				 (gptel-review-test--submit "Edit" '(:path "." :operations
									   [(:operation "insert" :path "one" :line_number -1 :new_str "tail")
									    (:operation "write" :path "dependent" :content "dependent")]))
				 (gptel-review-test--submit "Insert" '(:path "dependent" :line_number 0 :new_str "more"))
				 (gptel-review-test--submit "Edit" '(:path "two" :old_str "two" :new_str "TWO"))
				 (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Keep this behavior"))
					   ((symbol-function 'recursive-edit)
					    (lambda ()
					      (with-current-buffer (buffer-local-value 'ediff-buffer-B (gptel-edit-test--control))
						(goto-char (point-min))
						(call-interactively (key-binding (kbd "H"))))
					      (should-not outcomes)
					      (gptel-edit-test--key "q"))))
				   (gptel-review-test--in-queue
				    (gptel-review-test--select 1)
				    (gptel-agent-review-proposal)))
				 (should-not outcomes)
				 (should (equal (plist-get (gptel-review-test--submit "Read" '(:file_path "one")) :result) "old\n"))
				 (gptel-review-test--in-queue
				  (should (equal (mapcar (lambda (p) (plist-get p :status))
							 (gptel-agent-review--queue-proposals gptel-agent-review--queue))
						 '(cancelled cancelled cancelled pending)))
				  (gptel-agent-review-accept-all)
				  (gptel-agent-review-done))
				 (should (equal (gptel-edit-test--read "one") "old\n"))
				 (should-not (file-exists-p "dependent"))
				 (should (equal (gptel-edit-test--read "two") "TWO\n"))
				 (should (string-match-p "one (proposed changes), line 1" (cadar outcomes)))
				 (should (string-match-p "Keep this behavior" (cadar outcomes)))
				 (should (caddar outcomes))))

