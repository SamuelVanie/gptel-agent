(ert-deftest gptel-agent-search-timeout-timer-stops-process-once ()
  (skip-unless (or (executable-find "rg") (executable-find "grep")))
  (gptel-agent-read-test--with-file (file source "needle\n")
                                    (let ((make (symbol-function 'make-process))
                                          (schedule (symbol-function 'run-at-time)) results job)
                                      (cl-letf (((symbol-function 'make-process)
                                                 (lambda (&rest args)
                                                   (apply make (plist-put args :command '("/bin/sleep" "5")))))
                                                ((symbol-function 'run-at-time)
                                                 (lambda (time repeat function &rest args)
                                                   (apply schedule (if (eql time 30) 0.02 time) repeat function args))))
                                        (gptel-agent--grep-scoped-result (lambda (value) (push value results)) "needle"))
                                      (setq job (car gptel-agent--searches))
                                      (gptel-agent-read-test--wait (lambda () results))
                                      (should (string-match-p "incomplete: timeout" (car results)))
                                      (should-not (process-live-p (gptel-agent--search-process job)))
                                      (gptel-agent--search-finish job "complete")
                                      (should (= 1 (length results)))
                                      (should-not gptel-agent--searches))))

