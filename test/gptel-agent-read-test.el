                                      (should (string-match-p "incomplete: file changed" (car results)))
                                      (should-not (string-match-p "No nonempty matches" (car results)))
                                      (setq results nil)
                                      (cl-letf (((symbol-function 'executable-find) (lambda (&rest _) nil)))
                                        (gptel-agent--grep-scoped-result (lambda (value) (push value results)) "needle"))
                                      (setq job (car gptel-agent--searches))
                                      (gptel-agent--search-finish job "incomplete: timeout")
                                      (should (string-match-p "incomplete: timeout" (car results)))
                                      (should-not (string-match-p "No nonempty matches" (car results))))))

(ert-deftest gptel-agent-search-native-regex-features-and-invalid-patterns ()
  (gptel-agent-read-test--with-file (file source "WARN42\nαβγ\nabab\nERROR timeout\n")
                                    (dolist (case '(("rg" "\\p{Greek}+" ":2:1:")
                                                    ("rg" "(?i:warn)[0-9]+" ":1:1:")
                                                    ("grep" "^(WARN|ERROR)[0-9]+$" ":1:1:")
                                                    (nil "\\(ab\\)\\1" ":3:1:")
                                                    (nil "ERROR.*timeout" ":4:1:")))
      (when (or (null (car case)) (executable-find (car case)))
        (should (string-match-p (nth 2 case)
                                (gptel-agent-read-test--search (car case) (cadr case) t)))))
                                    (gptel-agent-read-test--backends
                                     (let ((result (gptel-agent-read-test--search backend "[" t)))
                                       (should (string-match-p "incomplete:" result))
                                       (should-not (string-match-p "No nonempty matches" result))))))

