;;; gptel-agent-history-test.el --- Snapshot and live review tests -*- lexical-binding: t; -*-

(require 'gptel-agent-review-test)

(ert-deftest gptel-review-live-edits-are-testable-before-acceptance ()
  (gptel-review-test--with-files '(("check.sh" . "exit 9\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (let ((call (gptel-review-test--submit
                   "Edit" '(:path "check.sh" :old_str "exit 9" :new_str "printf 'verified\\n'"))))
        (should-not (plist-get call :error))
        (should (string-match-p "Applied changes" (plist-get call :result))))
      (should (eq (plist-get (gptel-review-test--file 1) :status) 'pending))
      (let (result)
        (let ((process (gptel-agent--execute-bash
                        (lambda (output) (setq result output))
                        "bash -n check.sh && bash check.sh" "Did the script pass?")))
          (while (process-live-p process) (accept-process-output process 0.1))
          (accept-process-output process 0.1))
        (should (equal result "verified\n")))
      (gptel-review-test--open 1)
      (let ((view (gptel-agent-review--queue-view gptel-agent-review--queue)))
        (should (equal (smv/gptel-ediff--view-before view) "exit 9\n")))
      (gptel-edit-test--key "q")
      (gptel-review-test--in-queue (gptel-agent-review-done))
      (should-not outcomes)
      (should-not gptel-agent-review--queue)
      (should (= 1 (length (gptel-agent-history--entries)))))))

(ert-deftest gptel-review-live-refusal-restores-cumulative-original ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "other\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "draft"))
      (gptel-review-test--submit "Insert" '(:path "one" :line_number -1 :new_str "tail"))
      (gptel-review-test--submit "Edit" '(:path "two" :old_str "other" :new_str "changed"))
      (gptel-agent-review--cancel gptel-agent-review--queue (gptel-review-test--file 1) "Keep behavior")
      (should (equal (gptel-edit-test--read "one") "old\n"))
      (should (equal (gptel-edit-test--read "two") "changed\n"))
      (should (string-match-p "restored" (cadar outcomes)))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "fixed"))
      (should (equal (plist-get (gptel-review-test--file 1) :before) "old\n"))
      (gptel-review-test--in-queue (gptel-agent-review-accept-all) (gptel-agent-review-done))
      (should (= 1 (length outcomes)))
      (should (equal (gptel-edit-test--read "one") "fixed\n")))))

(ert-deftest gptel-review-live-cancel-restores-created-deleted-and-empty-files ()
  (gptel-review-test--with-files '(("one" . "old\n") ("empty" . ""))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit
       "Edit" '(:path "." :operations [(:operation "delete" :path "one")
                                       (:operation "write" :path "empty" :content "filled")
                                       (:operation "write" :path "nested/new" :content "")]))
      (should-not (file-exists-p "one"))
      (should (file-exists-p "nested/new"))
      (gptel-review-test--in-queue (gptel-agent-review-cancel-all))
      (should (equal (gptel-edit-test--read "one") "old\n"))
      (should (equal (gptel-edit-test--read "empty") ""))
      (should-not (file-exists-p "nested/new"))
      (should-not gptel-agent-review--queue))))

(ert-deftest gptel-review-live-external-changes-refresh-before-refusal ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (dolist (path '("one" "two"))
        (gptel-review-test--submit "Edit" (list :path path :old_str "old" :new_str "new")))
      (with-temp-file "two" (insert "user edit\n"))
      (gptel-review-test--in-queue (should-error (gptel-agent-review-cancel-all)))
      (should (equal (gptel-edit-test--read "one") "new\n"))
      (should (equal (gptel-edit-test--read "two") "user edit\n"))
      (let ((call (gptel-review-test--submit "Edit" '(:path "two" :old_str "user edit" :new_str "replacement"))))
        (should-not (plist-get call :error)))
      (should (equal (gptel-edit-test--read "two") "replacement\n"))
      (should gptel-agent-review--queue)
      (should-not outcomes)
      (gptel-review-test--in-queue (gptel-agent-review-cancel-all))
      (should (equal (gptel-edit-test--read "one") "old\n"))
      (should (equal (gptel-edit-test--read "two") "old\n")))))

(ert-deftest gptel-review-live-formatter-read-edit-refreshes-buffers-and-history ()
  (gptel-review-test--with-files '(("one" . "const x=1\n"))
    (let ((gptel-agent-review-apply-immediately t)
          (buffer (find-file-noselect "one")))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "x=1" :new_str "x=2"))
      (gptel-review-test--open 1)
      (gptel-review-test--in-queue (gptel-agent-review-accept-all))
      (let* ((file (gptel-review-test--file 1))
             (view (gptel-agent-review--queue-view gptel-agent-review--queue))
             (control (smv/gptel-ediff--view-control view))
             (mtime (file-attribute-modification-time (file-attributes "one"))))
        ;; Simulate an external formatter, even with an unchanged timestamp.
        (should (zerop (call-process "bash" nil nil nil "-c" "printf 'const x = 2;\\n' > one")))
        (set-file-times "one" mtime)
        (should (equal (plist-get (gptel-review-test--submit "Read" '(:file_path "one")) :result)
                       "const x = 2;\n"))
        (should (eq file (gptel-review-test--file 1)))
        (should (eq control (smv/gptel-ediff--view-control view)))
        (should (equal (smv/gptel-ediff--view-before view) "const x=1\n"))
        (should (equal (with-current-buffer (smv/gptel-ediff--view-proposed view) (buffer-string))
                       "const x = 2;\n"))
        (should (equal (with-current-buffer buffer (buffer-string)) "const x = 2;\n"))
        (should (with-current-buffer buffer (verify-visited-file-modtime buffer)))
        (should-not (buffer-modified-p buffer))
        (should (= 2 (plist-get file :revision)))
        (should (plist-get file :external))
        (should (eq (plist-get file :status) 'pending))
        (should (= 2 (length (gptel-agent-history--entries))))
        (let ((snapshot (car (gptel-agent-history--entries))))
          (should (equal (gptel-agent-history--content snapshot "0-before") "const x=2\n"))
          (should (equal (gptel-agent-history--content snapshot "0-after") "const x = 2;\n")))
        (should-not (plist-get (gptel-review-test--submit
                               "Edit" '(:path "one" :old_str "x = 2" :new_str "x = 3")) :error))
        (should (= 3 (plist-get file :revision)))
        (gptel-edit-test--key "q")
        (gptel-review-test--in-queue (gptel-agent-review-done))
        (should (equal (gptel-edit-test--read "one") "const x = 3;\n"))
        (should-not outcomes)))))

(ert-deftest gptel-review-live-external-changes-allow-edit-without-reread ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "other\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
      (gptel-review-test--submit "Edit" '(:path "two" :old_str "other" :new_str "OTHER"))
      (let ((buffer (find-file-noselect "two")))
        (with-current-buffer buffer (insert "unsaved"))
        (with-temp-file "one" (insert "  new\n"))
        (should-not (plist-get (gptel-review-test--submit
                               "Edit" '(:path "one" :old_str "new" :new_str "final")) :error))
        (should (equal (gptel-edit-test--read "one") "  final\n"))
        (should (= 3 (plist-get (gptel-review-test--file 1) :revision)))
        (should (equal (plist-get (gptel-review-test--file 1) :before) "old\n"))
        (should (equal (with-current-buffer buffer (buffer-string)) "unsavedOTHER\n"))))))

(ert-deftest gptel-review-live-external-changes-invalidate-decisions ()
  (dolist (decision '(accept done ediff refuse cancel))
    (gptel-review-test--with-files '(("one" . "old\n"))
      (let ((gptel-agent-review-apply-immediately t))
        (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
        (gptel-review-test--open 1)
        (gptel-review-test--in-queue (gptel-agent-review-accept-all))
        (with-temp-file "one" (insert "formatted\n"))
        (should-error
         (pcase decision
           ('accept (gptel-review-test--in-queue (gptel-agent-review-accept-all)))
           ('done (gptel-review-test--in-queue (gptel-agent-review-done)))
           ('ediff (gptel-edit-test--key "q"))
           ('refuse (gptel-agent-review--cancel gptel-agent-review--queue (gptel-review-test--file 1) "No"))
           ('cancel (gptel-review-test--in-queue (gptel-agent-review-cancel-all))))
         :type 'user-error)
        (should gptel-agent-review--queue)
        (should (eq (plist-get (gptel-review-test--file 1) :status) 'pending))
        (should (equal (gptel-edit-test--read "one") "formatted\n"))
        (should-not outcomes)
        (gptel-agent-review--cancel gptel-agent-review--queue (gptel-review-test--file 1) "No")
        (should (equal (gptel-edit-test--read "one") "old\n"))
        (gptel-review-test--in-queue (gptel-agent-review-done))
        ;; The refusal itself is reversible, including the formatter's work.
        (gptel-agent-history-restore (car (gptel-agent-history--entries)))
        (should (equal (gptel-edit-test--read "one") "formatted\n"))))))

(ert-deftest gptel-review-live-sync-preserves-unsaved-buffers-and-feedback ()
  (gptel-review-test--with-files '(("one" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t)
          (buffer (find-file-noselect "one")))
      (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
      (gptel-agent-review--comment gptel-agent-review--queue (gptel-review-test--file 1) "Fix behavior")
      (with-current-buffer buffer (insert "unsaved"))
      (with-temp-file "one" (insert "formatted\n"))
      (gptel-review-test--in-queue (should-error (gptel-agent-review-refresh)))
      (should (= 1 (plist-get (gptel-review-test--file 1) :revision)))
      (should (= 1 (length (gptel-agent-history--entries))))
      (should (equal (with-current-buffer buffer (buffer-string)) "unsavednew\n"))
      (should (equal (gptel-edit-test--read "one") "formatted\n"))
      (with-current-buffer buffer (revert-buffer t t))
      (gptel-review-test--in-queue (gptel-agent-review-refresh))
      (should (eq (plist-get (gptel-review-test--file 1) :status) 'feedback))
      (should (= 2 (plist-get (gptel-review-test--file 1) :revision))))))

(ert-deftest gptel-review-live-post-shell-syncs-and-reports-failures-with-output ()
  (dolist (name '("Bash" "Process"))
    (gptel-review-test--with-files '(("one" . "old\n"))
      (let ((gptel-agent-review-apply-immediately t))
        (gptel-review-test--submit "Edit" '(:path "one" :old_str "old" :new_str "new"))
        (with-temp-file "one" (insert "formatted\n"))
        (let* ((call (list :name name :result "shell output"))
               (result (gptel-agent-review--post-tool call)))
          (should (string-prefix-p "shell output" (plist-get result :result)))
          (should (string-match-p "External changes added" (plist-get result :result)))
          (should-not (gptel-agent-review--post-tool call))
          (let ((buffer (find-file-noselect "one")))
            (with-current-buffer buffer (insert "unsaved"))
            (should (string-match-p "shell output\n\nFile review could not refresh"
                                    (plist-get (gptel-agent-review--post-tool call) :result)))))))))

(ert-deftest gptel-review-live-sync-tracks-deletion-recreation-and-skips-refusals ()
  (gptel-review-test--with-files '(("one" . "old\n") ("two" . "old\n"))
    (let ((gptel-agent-review-apply-immediately t))
      (gptel-review-test--submit "Edit" '(:path "." :operations
                                             [(:operation "write" :path "one" :content "new\n")
                                              (:operation "delete" :path "two")]))
      (delete-file "one")
      (with-temp-file "two")
      (gptel-review-test--in-queue (gptel-agent-review-refresh))
      (should-not (plist-get (gptel-review-test--file 1) :after))
      (should (equal (plist-get (gptel-review-test--file 2) :after) ""))
      (gptel-agent-review--cancel gptel-agent-review--queue (gptel-review-test--file 1) "No")
      (with-temp-file "one" (insert "independent\n"))
      (gptel-review-test--in-queue (gptel-agent-review-cancel-all))
      (should (equal (gptel-edit-test--read "one") "independent\n"))
      (should (equal (gptel-edit-test--read "two") "old\n")))))

(ert-deftest gptel-review-live-sync-history-failure-keeps-original-snapshots ()
