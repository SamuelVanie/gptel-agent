;;; gptel-agent-result-storage-test.el --- Private output storage -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'gptel-agent)

(cl-defmacro gptel-agent-result-storage-test--with-root ((scratch root) &body body)
  "Run BODY with a disposable SCRATCH and shared temporary ROOT.
Exercise the real storage helper, with no result directory inherited from
other tests.  All hostile paths and their targets stay inside SCRATCH."
  (declare (indent 1))
  `(let* ((,scratch (make-temp-file "gptel-result-storage-test-" t))
          (,root (expand-file-name "shared" ,scratch))
          (temporary-file-directory (file-name-as-directory ,root))
          (default-directory (file-name-as-directory ,scratch))
          (gptel-agent--tool-results-storage nil)
          (gptel-agent--saved-tool-results (make-hash-table :test #'equal))
         (gptel-agent--result-resources (make-hash-table :test #'equal))
         (gptel-agent--results-timer nil))
     (unwind-protect
         (progn
           (make-directory ,root)
           (set-file-modes ,root #o1777)
           ,@body)
       (gptel-agent--results-exit-cleanup)
       (delete-directory ,scratch t))))

(cl-defmacro gptel-agent-result-storage-test--with-job ((job results) &body body)
  "Run BODY with a foreground JOB and its callback RESULTS."
  (declare (indent 1))
  (let ((source (make-symbol "source"))
        (output (make-symbol "output")))
    `(let* ((,source (generate-new-buffer " *result-storage-source*"))
            (,output (generate-new-buffer " *result-storage-output*"))
            ,results
            (,job (gptel-agent--make-bash
                   :source ,source :buffer ,output
                   :callback (lambda (value) (push value ,results))
                   :query "Find evidence" :limit 3 :preview-chars 3
                   :preview-lines 1)))
       (unwind-protect
           (progn ,@body)
         (gptel-agent--bash-dispose ,job)
         (when (buffer-live-p ,source) (kill-buffer ,source))
         (when (buffer-live-p ,output) (kill-buffer ,output))))))

(defun gptel-agent-result-storage-test--read (file)
  "Return FILE's contents."
  (with-temp-buffer
    (insert-file-contents file)
    (buffer-string)))

(defun gptel-agent-result-storage-test--save (&optional prefix)
  "Save sample evidence using PREFIX and the real generic result writer."
  (let ((owner (current-buffer)))
    (with-temp-buffer
      (insert "saved evidence\n")
      (gptel-agent--save-tool-result (or prefix "test") "Find evidence" owner))))

(ert-deftest gptel-agent-result-storage-ignores-untrusted-legacy-paths ()
  (dolist (symlink '(nil t))
    (gptel-agent-result-storage-test--with-root (scratch root)
      (let* ((legacy (expand-file-name "gptel-agent-temp" root))
             (target (if symlink (expand-file-name "attacker" scratch) legacy))
             (sentinel (expand-file-name "untouched" target)))
        (make-directory target)
        (set-file-modes target #o777)
        (with-temp-file sentinel (insert "untouched"))
        (when symlink (make-symbolic-link target legacy))
        (gptel-agent-result-storage-test--with-job (job results)
          (gptel-agent--bash-filter job nil "first")
          (gptel-agent--bash-filter job nil " second")
          (let* ((bash-file (gptel-agent--bash-file job))
                 (saved-file (gptel-agent-result-storage-test--save))
                 (directory (directory-file-name (file-name-directory bash-file))))
            (should-not results)
            (should (equal (gptel-agent-result-storage-test--read bash-file)
                           "first second"))
            (should (equal (file-name-directory bash-file)
                           (file-name-directory saved-file)))
            (should (file-in-directory-p directory root))
            (should-not (equal directory legacy))
            (should-not (file-symlink-p directory))
            (should (= (file-modes directory) #o700))
            (dolist (file (list bash-file saved-file))
              (should (= (file-modes file) #o600))
              (should (= (file-attribute-user-id (file-attributes file 'integer))
                         (user-uid))))
            (should (equal (gptel-agent-result-storage-test--read saved-file)
                           "saved evidence\n"))
            (should-not (gptel-agent--result-explorer-contract-error
                         saved-file "Find evidence"))
            (let ((gptel-agent--current-agent "result-explorer")
                  (gptel-agent--result-file-scope saved-file))
              (should (string-match-p "1:saved evidence"
                                      (gptel-agent--read-scoped-result 1 1))))))
        (should (equal (gptel-agent-result-storage-test--read sentinel) "untouched"))
        (should (equal (directory-files target nil directory-files-no-dot-files-regexp)
                       '("untouched")))
        (should (= (file-modes target) #o777))
        (when symlink (should (equal (file-symlink-p legacy) target)))))))

(ert-deftest gptel-agent-result-storage-rejects-replaced-cached-directory ()
  (dolist (symlink '(nil t))
    (gptel-agent-result-storage-test--with-root (scratch root)
      (let* ((directory (directory-file-name (gptel-agent--tool-results-directory)))
             (original (expand-file-name "original" scratch))
             (replacement (if symlink (expand-file-name "replacement" scratch)
                            directory)))
        (with-temp-file (expand-file-name "original" directory) (insert "original"))
        (rename-file directory original)
        (make-directory replacement)
        (set-file-modes replacement #o700)
        (with-temp-file (expand-file-name "untouched" replacement) (insert "untouched"))
        (when symlink (make-symbolic-link replacement directory))
        (should-error (gptel-agent--tool-results-directory))
        (should-error (gptel-agent-result-storage-test--save))
        (should (equal (directory-files replacement nil directory-files-no-dot-files-regexp)
                       '("untouched")))
        (should (equal (gptel-agent-result-storage-test--read
                        (expand-file-name "original" original))
                       "original"))
        (when symlink (should (equal (file-symlink-p directory) replacement)))))))

(ert-deftest gptel-agent-result-storage-rejects-relaxed-cached-permissions ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (let* ((directory (gptel-agent--tool-results-directory))
           (sentinel (expand-file-name "untouched" directory)))
      (with-temp-file sentinel (insert "untouched"))
      (set-file-modes directory #o777)
      (should-error (gptel-agent--tool-results-directory))
      (should-error (gptel-agent-result-storage-test--save))
      (should (= (file-modes directory) #o777))
      (should (equal (gptel-agent-result-storage-test--read sentinel) "untouched")))))

(ert-deftest gptel-agent-result-storage-rejects-foreign-directory-owner ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (let* ((directory (directory-file-name (gptel-agent--tool-results-directory)))
           (attributes (symbol-function 'file-attributes)))
      ;; Ownership changes require privileges; emulate only lstat's uid for our
      ;; disposable directory, leaving every other path and attribute real.
      (cl-letf (((symbol-function 'file-attributes)
                 (lambda (file &optional id-format)
                   (let ((value (funcall attributes file id-format)))
                     (when (equal (directory-file-name file) directory)
                       (setq value (copy-sequence value))
                       (setf (nth 2 value) (+ (user-uid) 10000)))
                     value))))
        (should-error (gptel-agent--tool-results-directory))
        (should-error (gptel-agent-result-storage-test--save)))
      (should-not (directory-files directory nil directory-files-no-dot-files-regexp)))))

(ert-deftest gptel-agent-result-storage-rejects-unsafe-temp-root ()
  (dolist (ancestor '(nil t))
    (gptel-agent-result-storage-test--with-root (scratch root)
      (set-file-modes (if ancestor scratch root) #o777)
      (should-error (gptel-agent--tool-results-directory))
      (should-error (gptel-agent-result-storage-test--save))
      (should-not (directory-files root nil directory-files-no-dot-files-regexp)))))

(ert-deftest gptel-agent-result-storage-rejects-foreign-temp-root-owners ()
  (dolist (ancestor '(nil t))
    (gptel-agent-result-storage-test--with-root (scratch root)
      (let ((untrusted (directory-file-name (file-truename (if ancestor scratch root))))
            (attributes (symbol-function 'file-attributes)))
        (cl-letf (((symbol-function 'file-attributes)
                   (lambda (file &optional id-format)
                     (let ((value (funcall attributes file id-format)))
                       (when (equal (directory-file-name file) untrusted)
                         (setq value (copy-sequence value))
                         (setf (nth 2 value) (+ (user-uid) 10000)))
                       value))))
          (should-error (gptel-agent--tool-results-directory))
          (should-error (gptel-agent-result-storage-test--save)))
        (should-not (directory-files root nil directory-files-no-dot-files-regexp))))))

(ert-deftest gptel-agent-result-storage-canonicalizes-local-temp-root-alias ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (let* ((alias (expand-file-name "temp-alias" scratch))
           (replacement (expand-file-name "replacement" scratch))
           (temporary-file-directory (file-name-as-directory alias)))
      (make-symbolic-link root alias)
      (let ((first (gptel-agent-result-storage-test--save)))
        (should (string-prefix-p (file-name-as-directory (file-truename root)) first))
        (should-not (string-prefix-p (file-name-as-directory alias) first))
        ;; A changed alias cannot redirect the retained canonical storage path.
        (make-directory replacement)
        (delete-file alias)
        (make-symbolic-link replacement alias)
        (let ((second (gptel-agent-result-storage-test--save)))
          (should (equal (file-name-directory first) (file-name-directory second)))
          (should (equal (gptel-agent-result-storage-test--read second)
                         "saved evidence\n")))
        (should-not (directory-files replacement nil directory-files-no-dot-files-regexp))))))

(ert-deftest gptel-agent-result-storage-rejects-bash-log-symlink-before-append ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (let ((victim (expand-file-name "victim" scratch)))
      (with-temp-file victim (insert "original"))
      (gptel-agent-result-storage-test--with-job (job results)
        (gptel-agent--bash-filter job nil "first")
        (let ((file (gptel-agent--bash-file job)))
          (delete-file file)
          (make-symbolic-link victim file)
          (gptel-agent--bash-filter job nil "redirected append")
          (gptel-agent--bash-filter job nil "late output")
          (should (equal (gptel-agent-result-storage-test--read victim) "original"))
          (should (gptel-agent--bash-done job))
          (should (= (length results) 1))
          (should (string-match-p "Could not capture Bash output" (car results)))
          ;; Cleanup must leave the substituted path alone.
          (should (equal (file-symlink-p file) victim))
          (should (zerop (hash-table-count gptel-agent--saved-tool-results))))))))

(ert-deftest gptel-agent-result-storage-bash-cleanup-rejects-replaced-parent ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (gptel-agent-result-storage-test--with-job (job results)
      (gptel-agent--bash-filter job nil "first")
      (let* ((file (gptel-agent--bash-file job))
             (directory (directory-file-name (file-name-directory file)))
             (original (expand-file-name "original" scratch))
             (replacement (expand-file-name "replacement" scratch)))
        (rename-file directory original)
        (make-directory replacement)
        (make-symbolic-link replacement directory)
        (with-temp-file file (insert "untouched"))
        (gptel-agent--bash-filter job nil "redirected append")
        (should (= (length results) 1))
        (should (string-match-p "Could not capture Bash output" (car results)))
        (should (gptel-agent--bash-done job))
        (should (equal (gptel-agent-result-storage-test--read file) "untouched"))
        (should (equal (gptel-agent-result-storage-test--read
                        (expand-file-name (file-name-nondirectory file) original))
                       "first"))
        (should (equal (file-symlink-p directory) replacement))))))

(ert-deftest gptel-agent-result-storage-rejects-tampered-bash-files ()
  (dolist (tampering '(permissions hardlink replacement))
    (gptel-agent-result-storage-test--with-root (scratch root)
      (gptel-agent-result-storage-test--with-job (job results)
        (gptel-agent--bash-filter job nil "first")
        (let ((file (gptel-agent--bash-file job))
              (alias (expand-file-name "original" scratch)))
          (pcase tampering
            ('permissions (set-file-modes file #o666))
            ('hardlink (add-name-to-file file alias))
            ('replacement
             (rename-file file alias)
             (with-temp-file file (insert "replacement"))
             (set-file-modes file #o600)))
          (gptel-agent--bash-filter job nil "must not be written")
          (should (= (length results) 1))
          (should (string-match-p "Could not capture Bash output" (car results)))
          (should (gptel-agent--bash-done job))
          (should (equal (gptel-agent-result-storage-test--read file)
                         (if (eq tampering 'replacement) "replacement" "first")))
          (when (file-exists-p alias)
            (should (equal (gptel-agent-result-storage-test--read alias) "first"))))))))

(ert-deftest gptel-agent-result-storage-generic-save-rejects-substituted-file ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (let ((victim (expand-file-name "victim" scratch))
          (create (symbol-function 'make-temp-file))
          substituted)
      (with-temp-file victim (insert "original"))
      ;; Substitute the freshly created file before the generic writer gets it.
      ;; This deliberately uses our own uid, emulating the old attacker-owned
      ;; directory without needing another account or touching real user data.
      (cl-letf (((symbol-function 'make-temp-file)
                 (lambda (prefix &optional directory suffix text)
                   (let ((file (funcall create prefix directory suffix text)))
                     (unless directory
                       (setq substituted file)
                       (delete-file file)
                       (make-symbolic-link victim file))
                     file))))
        (should-error (gptel-agent-result-storage-test--save)))
      (should substituted)
      (should (equal (gptel-agent-result-storage-test--read victim) "original"))
      (should (equal (file-symlink-p substituted) victim))
      (should (zerop (hash-table-count gptel-agent--saved-tool-results))))))

(ert-deftest gptel-agent-result-storage-stays-local-for-remote-buffers ()
  (gptel-agent-result-storage-test--with-root (scratch root)
    (let ((default-directory "/ssh:must-not-connect.invalid:/remote/"))
      (cl-letf (((symbol-function 'temporary-file-directory)
                 (lambda () (ert-fail "Selected a remote temporary directory"))))
        (let ((file (gptel-agent-result-storage-test--save)))
          (should-not (file-remote-p file))
          (should (file-in-directory-p file root))
          (should (equal (gptel-agent-result-storage-test--read file)
                         "saved evidence\n")))))))

